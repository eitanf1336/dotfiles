#!/bin/bash
# gpu-primary-guard: auto-revert the NVIDIA-primary udev rule if it ever stops
# the machine reaching a working graphical session.
#
# Runs once per boot, before GDM. It increments a counter; a successful login
# resets that counter to 0 (see the user unit gpu-primary-ok.service). So the
# counter only climbs when boots are NOT reaching a desktop. After two such
# boots the third one removes the rule, and the machine comes back on the stock
# Intel-primary path instead of login-looping forever.
set -u
RULE=/etc/udev/rules.d/61-mutter-primary-gpu.rules
STATE=/var/lib/gpu-primary
COUNT="$STATE/failcount"

[ -e "$RULE" ] || exit 0        # nothing to guard

mkdir -p "$STATE"
n=$(cat "$COUNT" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0;; esac

if [ "$n" -ge 2 ]; then
  rm -f "$RULE"
  udevadm control --reload-rules 2>/dev/null
  udevadm trigger -s drm 2>/dev/null
  echo 0 > "$COUNT"
  echo "gpu-primary-guard: $n boots without a successful graphical login -> reverted to Intel primary GPU" | systemd-cat -t gpu-primary-guard -p warning
  exit 0
fi

echo "$((n + 1))" > "$COUNT"
chown eitan:eitan "$COUNT" 2>/dev/null
exit 0
