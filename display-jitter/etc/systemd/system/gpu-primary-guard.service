[Unit]
Description=Revert NVIDIA-primary GPU rule if boots stop reaching a desktop
Before=gdm.service display-manager.service
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/gpu-primary-guard
RemainAfterExit=no

[Install]
WantedBy=sysinit.target
