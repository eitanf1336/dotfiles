#!/bin/bash
# Count one graphical login attempt for gpu-primary-guard (see there). Runs as
# the user at graphical-session-pre, before GNOME Shell starts.
[ -e /etc/udev/rules.d/61-mutter-primary-gpu.rules ] || exit 0
f=/var/lib/gpu-primary/logincount
n=$(cat "$f" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0;; esac
echo "$((n + 1))" > "$f" 2>/dev/null || true
exit 0
