// Let the user at the machine actually complete a "Restart Anyway" /
// "Power Off Anyway" while an app holds a shutdown block inhibitor.
//
// GNOME 50's gnome-session-service takes a logind block inhibitor on
// "shutdown" whenever an app inhibits logout (unsaved documents, a file
// copy, ...), and then its own Reboot() call is refused with
// BlockedByInhibitorLock, so the power menu silently does nothing.
// ~/.local/bin/power-menu-rescue retries with `systemctl reboot|poweroff -i`,
// which needs these actions.  Only for the active local session; the same
// user can already reboot without a password, this just skips the
// "an app is busy" veto they already clicked through.
//
// The sleep actions are here for the same reason: ~/bin/await-claude-shut
// ("Suspend when Claude's done") escalates to `systemctl suspend -i` when a
// block inhibitor refuses the sleep, and without this it would sit waiting for
// a password nobody is there to type - the whole point is that the user walked
// away.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.login1.reboot-ignore-inhibit" ||
         action.id == "org.freedesktop.login1.power-off-ignore-inhibit" ||
         action.id == "org.freedesktop.login1.halt-ignore-inhibit" ||
         action.id == "org.freedesktop.login1.suspend-ignore-inhibit" ||
         action.id == "org.freedesktop.login1.hibernate-ignore-inhibit") &&
        subject.user == "eitan" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
