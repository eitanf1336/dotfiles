#!/usr/bin/env bash
# takeover - hand the whole laptop to one job until it is done.
#
#   takeover start [-l label] -- <command...>   freeze everything else, run the job at full
#                                               priority, show a progress window, thaw when done
#   takeover hold [-l label] [--keep PATTERN ...]   same freeze and screen, but no command:
#                           the caller (a Claude chat) keeps working and ends it with
#                           `takeover finish`. --keep protects extra units (a Minecraft bot's
#                           service, a testbed) from the freeze; the caller's own scope is
#                           always kept.
#   Standing exclusions live in ~/.config/takeover/keep-units (unit name regex per line) and
#   keep-chats (a Claude chat name substring per line): those are never frozen.
#   takeover note "text"    a line for the notes area on the screen (white text, last 10 kept)
#   takeover progress DONE TOTAL [label]   drive the progress bar by hand
#   Other Claude chats are NOT frozen by default (their terminals keep running); pass
#   --freeze-claudes to start or hold if you want them frozen too.
#   takeover pause          pause or resume the job (Ctrl+Alt+P does this)
#   takeover finish         thaw everything and close the window (runs by itself at the end)
#   takeover thaw UNIT...   un-freeze just those units mid-blackout and leave the rest frozen.
#                           This is the escape hatch for a Claude chat whose server got frozen:
#                           `systemctl start` on a frozen unit silently does NOTHING (it is
#                           already 'active'), and `systemctl restart/stop` refuses with
#                           "Cannot perform operation on frozen unit". Thaw is the only move.
#   takeover status         what is frozen, what is running
#   takeover plan           list what a takeover WOULD freeze, change nothing
#
# "Freeze" is the systemd cgroup freezer: every app scope (Chrome, Spotify, JetBrains, the
# other terminals and their Claude chats) and every non-essential user service (PolyArena
# and friends) is stopped in place, keeps its memory and state, and continues exactly where
# it was when thawed. Nothing is killed, nothing loses work. Frozen programs can be swapped
# out fully, which is what gives the job the RAM.
#
# Never frozen: the desktop itself, audio, the VPN client, the keep-awake service, the
# WhatsApp bridge and bot (so the result can be sent), the terminal that ran `takeover`.
#
# Progress: the job writes "done total label" lines to $PROGRESS (render_range.sh does);
# the window reads it every 2 s.
set -uo pipefail
STATE_DIR="$HOME/.cache/takeover"; mkdir -p "$STATE_DIR"
FROZEN="$STATE_DIR/frozen"; PROGRESS="$STATE_DIR/progress"; LABEL_F="$STATE_DIR/label"; PAUSED="$STATE_DIR/paused"; NOTES="$STATE_DIR/notes"; KEEP_EXTRA="$STATE_DIR/keep"
JOB=takeover-job
KEEP_RE='^(init\.scope|takeover|cuteworld-render|perimeter81|.*claude-keep-awake|.*claude-whatsapp.*|.*whatsapp.*|whatclaude|power-menu-rescue|power-profile-auto|ssh-agent|ydotool|snap\.snapd|flatpak-session-helper|language-path|dbus|gnome|org\.|xdg|pipewire|wireplumber|at-spi|gvfs|dconf|evolution|app-gnome-org\.gnome\.(Evolution|SettingsDaemon)|app-gnome-update|app-gnome-perimeter81)'
MY_SCOPE=$(grep -oE '[^/]+\.scope$' /proc/self/cgroup | head -1)

CONF="$HOME/.config/takeover"          # keep-units: regex per line; keep-chats: a Claude chat name substring per line

chat_scopes_to_keep() {   # scopes of every Claude chat or agent whose name matches keep-chats
  [ -s "$CONF/keep-chats" ] || return 0
  timeout 15 claude agents --json 2>/dev/null | python3 -c '
import json, sys, re
pats = [l.strip().lower() for l in open(sys.argv[1]) if l.strip()]
try: a = json.load(sys.stdin)
except Exception: sys.exit(0)
a = a if isinstance(a, list) else a.get("agents", a)
for x in a:
    n = (x.get("name") or "").lower(); pid = x.get("pid")
    if pid and any(p in n for p in pats):
        try:
            cg = open(f"/proc/{pid}/cgroup").read().strip()
            m = re.search(r"([^/]+\.scope)$", cg)
            if m: print(m.group(1))
        except OSError: pass
' "$CONF/keep-chats" 2>/dev/null | sort -u
}

claude_scopes() {   # terminal scopes that hold a Claude chat: kept by default (--freeze-claudes overrides)
  for d in /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/*/*.scope; do
    [ -r "$d/cgroup.procs" ] || continue
    for pid in $(cat "$d/cgroup.procs" 2>/dev/null); do
      case "$(cat /proc/$pid/comm 2>/dev/null)" in claude) basename "$d"; break;; esac
    done
  done | sort -u
}

chats_own_chromes() {   # $1 keep regex: headless Chromes a kept chat launched stay with that chat
  # Chrome moves its browser process into its own app-com.google.Chrome-<pid>.scope but leaves the GPU
  # and renderer processes in the chat's terminal scope. Freezing that scope froze half a Chrome: the
  # chat's job hung, a timeout's SIGTERM waited on the freezer, and the unfrozen GPU process kept
  # software-rendering on 12 cores until someone thawed it (2026-09-23).
  local d pid pp cmd pscope
  for d in /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/app.slice/app-com.google.Chrome-*.scope; do
    [ -r "$d/cgroup.procs" ] || continue
    for pid in $(cat "$d/cgroup.procs" 2>/dev/null); do
      cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null); [[ $cmd == *--headless* ]] || continue
      pp=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
      pscope=$(grep -oE '[^/]+\.scope$' "/proc/${pp:-0}/cgroup" 2>/dev/null)
      [ -n "$pscope" ] && grep -qE "$1" <<< "$pscope" && { basename "$d"; break; }
    done
  done
}

units_to_freeze() {
  local extra="__none__"
  [ -e "$STATE_DIR/freeze-claudes" ] || claude_scopes >> "$KEEP_EXTRA"
  { [ -s "$KEEP_EXTRA" ] && cat "$KEEP_EXTRA"; [ -s "$CONF/keep-units" ] && cat "$CONF/keep-units"; chat_scopes_to_keep; } > "$STATE_DIR/keep.all" 2>/dev/null
  [ -s "$STATE_DIR/keep.all" ] && extra=$(grep -v '^$' "$STATE_DIR/keep.all" | sed 's/[][\.^$*+?(){}|]/\\&/g' | paste -sd'|')
  systemctl --user list-units --type=service,scope --state=running --no-pager --plain \
    | awk 'NR>1 && $1 ~ /\.(service|scope)$/ {print $1}' \
    | grep -v -E "$KEEP_RE" | grep -v -F "${MY_SCOPE:-__none__}" | grep -v -E "^${JOB}\.service$" | grep -v -E "$extra" \
    | grep -v -x -F -f <(chats_own_chromes "$extra"; echo __none__)
}

freeze_all() {   # $1 label
  echo "$1" > "$LABEL_F"; : > "$PROGRESS"; : > "$NOTES"; rm -f "$PAUSED"; : > "$FROZEN"
  for u in $(units_to_freeze); do
    systemctl --user freeze "$u" 2>/dev/null && echo "$u" >> "$FROZEN"
  done
  echo "frozen $(wc -l < "$FROZEN") units; starting $1"
  # give the job the machine: performance profile, and the frozen programs' RAM pushed to swap
  powerprofilesctl get > "$STATE_DIR/profile.prev" 2>/dev/null
  powerprofilesctl set performance 2>/dev/null
  reclaimed=0
  while read -r u; do
    cg=$(systemctl --user show -p ControlGroup --value "$u" 2>/dev/null); [ -n "$cg" ] || continue
    f="/sys/fs/cgroup$cg/memory.reclaim"
    [ -w "$f" ] && echo "4G" > "$f" 2>/dev/null && reclaimed=$((reclaimed+1))
  done < "$FROZEN"
  echo "performance profile on; asked $reclaimed frozen programs to give up their RAM"
}

cmd=${1:-status}; shift || true
case "$cmd" in
  plan)
    echo "would freeze:"; units_to_freeze | sed 's/^/  /'
    echo "would keep: the desktop, audio, VPN, keep-awake, WhatsApp bridge+bot, this terminal ($MY_SCOPE)"
    ;;
  start)
    label="job"; rm -f "$STATE_DIR/freeze-claudes"; : > "$KEEP_EXTRA"
    while [ $# -gt 0 ]; do case "$1" in
      -l) label=$2; shift 2;;
      --keep) echo "$2" >> "$KEEP_EXTRA"; shift 2;;
      --freeze-claudes) touch "$STATE_DIR/freeze-claudes"; shift;;
      --) shift; break;;
      *) break;;
    esac; done
    [ $# -gt 0 ] || { echo "takeover start [-l label] -- <command...>" >&2; exit 2; }
    if systemctl --user is-active --quiet "$JOB"; then echo "a takeover is already running (takeover status)" >&2; exit 1; fi
    freeze_all "$label"
    # the job: full priority, its own cgroup, thaws everything when it exits however it exits
    systemd-run --user --unit="$JOB" --collect -p OOMScoreAdjust=300 \
      bash -c 'cd "$1"; shift; "$@"; rc=$?; TAKEOVER_INSIDE_JOB=1 takeover finish; exit $rc' _ "$PWD" "$@" >/dev/null
    setsid -f "$0" gui >/dev/null 2>&1
    notify-send -i utilities-system-monitor "Takeover: $label" "Everything else is frozen. Ctrl+Alt+P pauses." 2>/dev/null
    ;;
  hold)
    label="blackout"; : > "$KEEP_EXTRA"; rm -f "$STATE_DIR/freeze-claudes"
    while [ $# -gt 0 ]; do case "$1" in
      -l) label=$2; shift 2;;
      --keep) echo "$2" >> "$KEEP_EXTRA"; shift 2;;
      --freeze-claudes) touch "$STATE_DIR/freeze-claudes"; shift;;
      *) shift;;
    esac; done
    if systemctl --user is-active --quiet "$JOB"; then echo "a takeover is already running (takeover status)" >&2; exit 1; fi
    freeze_all "$label"
    # the job is a placeholder that lives until `takeover finish`; the caller does the work
    systemd-run --user --unit="$JOB" --collect -p OOMScoreAdjust=300 bash -c 'while :; do sleep 3600; done' >/dev/null
    setsid -f "$0" gui >/dev/null 2>&1
    notify-send -i utilities-system-monitor "Blackout: $label" "Everything else is frozen. Ctrl+Alt+P pauses, the screen's button gives the laptop back." 2>/dev/null
    ;;
  note)
    printf '%s  %s\n' "$(date +%H:%M)" "$*" >> "$NOTES"; tail -n 10 "$NOTES" > "$NOTES.tmp" && mv "$NOTES.tmp" "$NOTES"
    ;;
  progress)
    [ $# -ge 2 ] || { echo "takeover progress DONE TOTAL [label]" >&2; exit 2; }
    echo "$*" >> "$PROGRESS"
    ;;
  pause)
    if ! systemctl --user is-active --quiet "$JOB"; then echo "no takeover job running"; exit 1; fi
    if [ -e "$PAUSED" ]; then
      systemctl --user thaw "$JOB" && rm -f "$PAUSED" && notify-send "Takeover resumed" 2>/dev/null; echo resumed
    else
      systemctl --user freeze "$JOB" && touch "$PAUSED" && notify-send "Takeover paused" "Ctrl+Alt+P resumes." 2>/dev/null; echo paused
    fi
    ;;
  finish)
    n=0
    if [ -s "$FROZEN" ]; then
      while read -r u; do [ -n "$u" ] && systemctl --user thaw "$u" 2>/dev/null && n=$((n+1)); done < "$FROZEN"
    fi
    prev=$(cat "$STATE_DIR/profile.prev" 2>/dev/null); [ -n "$prev" ] && powerprofilesctl set "$prev" 2>/dev/null
    : > "$FROZEN"; rm -f "$PAUSED"; : > "$KEEP_EXTRA"
    echo "done" >> "$PROGRESS"
    # last, because when finish runs from inside the job this stops the caller too
    [ "${TAKEOVER_INSIDE_JOB:-}" = 1 ] || systemctl --user stop "$JOB" 2>/dev/null
    notify-send -i emblem-ok-symbolic "Takeover finished: $(cat "$LABEL_F" 2>/dev/null)" "Thawed $n programs. The laptop is yours." 2>/dev/null
    echo "thawed $n units"
    ;;
  thaw)
    # Hand a frozen unit back without ending the blackout: a chat that needs its
    # testbed or the dashboard can take just that one out of the freezer.
    [ $# -gt 0 ] || { echo "takeover thaw <unit-or-pattern> [...]   (takeover status lists what is frozen)" >&2; exit 2; }
    [ -s "$FROZEN" ] || { echo "nothing is frozen"; exit 1; }
    list=$(cat "$FROZEN"); n=0
    for pat in "$@"; do
      for u in $list; do
        printf '%s\n' "$u" | grep -qE -- "$pat" || continue
        if systemctl --user thaw "$u" 2>/dev/null; then
          n=$((n+1)); echo "thawed $u"
          printf '%s  thawed %s\n' "$(date +%H:%M)" "$u" >> "$NOTES"
        fi
        list=$(printf '%s\n' "$list" | grep -vxF "$u")
      done
    done
    printf '%s\n' "$list" | grep -v '^$' > "$FROZEN.tmp" 2>/dev/null; mv "$FROZEN.tmp" "$FROZEN"
    [ "$n" = 0 ] && { echo "nothing matched; takeover status lists what is frozen" >&2; exit 1; }
    echo "still frozen: $(wc -l < "$FROZEN")"
    ;;
  status)
    if systemctl --user is-active --quiet "$JOB"; then
      echo "job: running ($(cat "$LABEL_F" 2>/dev/null))$( [ -e "$PAUSED" ] && echo ' [PAUSED]')"; tail -1 "$PROGRESS" 2>/dev/null | sed 's/^/progress: /'
    else echo "job: none"; fi
    if [ -s "$FROZEN" ]; then echo "frozen ($(wc -l < "$FROZEN")):"; sed 's/^/  /' "$FROZEN"; else echo "frozen: nothing"; fi
    if [ -s "$FROZEN" ]; then
      echo "note: a frozen unit still reports 'active' and \`systemctl start\` on it does nothing."
      echo "      need one back? takeover thaw <unit>   (leaves the rest frozen)"
    fi
    ;;
  gui)
    exec python3 - "$PROGRESS" "$LABEL_F" "$PAUSED" "$JOB" "$NOTES" <<'PY'
"""Black window on every monitor, the progress on the primary one. Closes the moment the job
is gone. GTK 3, because it can place a fullscreen window on a chosen monitor (kipur does
the same)."""
import sys, time, subprocess, os
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango
PROGRESS, LABEL_F, PAUSED, JOB, NOTES = sys.argv[1:6]
t_start = time.time()
state = {"samples": [], "wins": []}

def running():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", JOB]).returncode == 0

css = Gtk.CssProvider()
css.load_from_data(b"""
window, .black { background-color: #07070a; }
label { color: #ece7d9; }
.big { font-size: 40px; font-weight: 600; }
.mid { font-size: 20px; }
.dim { font-size: 17px; color: #9a958a; }
progressbar trough, progressbar progress { min-height: 26px; }
button { font-size: 18px; padding: 10px 22px; }
""")
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

display = Gdk.Display.get_default()
n = display.get_n_monitors()
primary = display.get_primary_monitor()
prim_idx = 0
for i in range(n):
    if display.get_monitor(i) is primary:
        prim_idx = i
widgets = {}
for i in range(n):
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("Takeover"); win.set_decorated(False); win.set_keep_above(True)
    win.get_style_context().add_class("black")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_valign(Gtk.Align.CENTER); box.set_halign(Gtk.Align.CENTER)
    win.add(box)
    if i == prim_idx:
        title = Gtk.Label(); title.get_style_context().add_class("big"); title.set_xalign(0); box.pack_start(title, False, False, 0)
        bar = Gtk.ProgressBar(); bar.set_show_text(True); bar.set_size_request(820, -1); box.pack_start(bar, False, False, 0)
        now_lab = Gtk.Label(); now_lab.get_style_context().add_class("mid"); now_lab.set_xalign(0); box.pack_start(now_lab, False, False, 0)
        sub_bar = Gtk.ProgressBar(); sub_bar.set_show_text(True); sub_bar.set_size_request(820, -1); box.pack_start(sub_bar, False, False, 0)
        info = Gtk.Label(); info.get_style_context().add_class("mid"); info.set_xalign(0); info.set_line_wrap(True); info.set_max_width_chars(70); box.pack_start(info, False, False, 0)
        hint = Gtk.Label(label="The laptop belongs to this job. Everything else is frozen in place: nothing is closed, nothing is lost.\nCtrl+Alt+P pauses and resumes.")
        hint.get_style_context().add_class("dim"); hint.set_xalign(0); hint.set_line_wrap(True); hint.set_max_width_chars(70); box.pack_start(hint, False, False, 0)
        notes = Gtk.Label(); notes.get_style_context().add_class("mid"); notes.set_xalign(0); notes.set_yalign(0)
        notes.set_line_wrap(True); notes.set_max_width_chars(90); notes.set_size_request(820, 260); box.pack_start(notes, False, False, 6)
        row = Gtk.Box(spacing=14); box.pack_start(row, False, False, 8)
        btn = Gtk.Button(label="Pause  (Ctrl+Alt+P)"); btn.connect("clicked", lambda _b: subprocess.run(["takeover", "pause"])); row.pack_start(btn, False, False, 0)
        stop = Gtk.Button(label="Stop and give the laptop back"); stop.get_style_context().add_class("destructive-action")
        def on_stop(_b):
            subprocess.run(["systemctl", "--user", "stop", JOB]); subprocess.run(["takeover", "finish"]); Gtk.main_quit()
        stop.connect("clicked", on_stop); row.pack_start(stop, False, False, 0)
        widgets = {"title": title, "bar": bar, "info": info, "btn": btn, "now": now_lab, "sub": sub_bar, "notes": notes}
    else:
        lab = Gtk.Label(label="working, see the main screen"); lab.get_style_context().add_class("dim"); box.pack_start(lab, False, False, 0)
    win.connect("delete-event", lambda *_: True)
    win.show_all()
    win.fullscreen_on_monitor(Gdk.Screen.get_default(), i)
    win.fullscreen()
    state["wins"].append(win)

def tick():
    if not running():
        Gtk.main_quit(); return False
    try: label = open(LABEL_F).read().strip()
    except OSError: label = "job"
    paused = os.path.exists(PAUSED)
    widgets["title"].set_text(("PAUSED: " if paused else "Working: ") + label)
    widgets["btn"].set_label(("Resume" if paused else "Pause") + "  (Ctrl+Alt+P)")
    last = ""
    try:
        lines = [l for l in open(PROGRESS).read().splitlines() if l.strip() and l.strip() != "done"]
        last = lines[-1] if lines else ""
    except OSError: pass
    try: widgets["notes"].set_text(open(NOTES).read().rstrip())
    except OSError: widgets["notes"].set_text("")
    parts = last.split()
    bar, info = widgets["bar"], widgets["info"]
    el = time.time() - t_start
    if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
        done, total = int(parts[0]), int(parts[1])
        sub = 0.0
        if "sample" in parts:                       # "... sample 5/16": credit the part of the frame already rendered
            try:
                a, b = parts[parts.index("sample") + 1].split("/"); sub = int(a) / max(1, int(b))
            except (ValueError, IndexError): sub = 0.0
        bar.set_fraction(min(1.0, (done + sub) / max(1, total))); bar.set_text(f"{done} of {total} {parts[2] if len(parts) > 2 else ''} finished")
        rest = " ".join(parts[3:]).strip(", ")
        widgets["now"].set_text("Now: " + (rest if rest else "starting the next frame"))
        widgets["sub"].set_fraction(sub); widgets["sub"].set_text(f"this frame {int(sub * 100)}%" if "sample" in parts else "loading")
        if "sample" not in parts: widgets["sub"].pulse()
        now = time.time(); samp = state["samples"]
        prog = done + sub
        if not samp or samp[-1][1] != prog: samp.append((now, prog))
        samp[:] = [x for x in samp if now - x[0] <= 300] or samp[-1:]
        if paused:
            info.set_text(f"{int(el//60)} min in. Paused.")
        elif len(samp) >= 2 and samp[-1][1] > samp[0][1]:
            rate = (samp[-1][1] - samp[0][1]) / max(1e-6, samp[-1][0] - samp[0][0])
            left = (total - prog) / rate
            info.set_text(f"{int(el//60)} min in. About {int(left//60)} min left at this pace, done around {time.strftime('%H:%M', time.localtime(now + left))}.")
        else:
            info.set_text(f"{int(el//60)} min in. Measuring the pace...")
    else:
        bar.pulse(); bar.set_text("working"); info.set_text(f"{int(el//60)} min in. No progress numbers from this job yet.")
        widgets["now"].set_text(""); widgets["sub"].pulse(); widgets["sub"].set_text("")
    return True

tick(); GLib.timeout_add(2000, tick)
Gtk.main()
PY
    ;;
  *) sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 2 ;;
esac
