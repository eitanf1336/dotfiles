#!/usr/bin/env bash
# takeover - hand the whole laptop to one job until it is done.
#
#   takeover start [-l label] -- <command...>   freeze everything else, run the job at full
#                                               priority, show a progress window, thaw when done
#   takeover pause          pause or resume the job (Ctrl+Alt+P does this)
#   takeover finish         thaw everything and close the window (runs by itself at the end)
#   takeover status         what is frozen, what is running
#   takeover plan           list what a takeover WOULD freeze, change nothing
#
# "Freeze" is the systemd cgroup freezer: every app scope (Chrome, Spotify, JetBrains, the
# other terminals and their Claude chats) and every non-essential user service (PolyArena
# and friends) is stopped in place, keeps its memory and state, and continues exactly where
# it was when thawed. Nothing is killed, nothing loses work. Frozen programs can be swapped
# out fully, which is what gives the job the RAM.
#
# Never frozen: the desktop itself, audio, the VPN client, the keep-awake service, the
# WhatsApp bridge and bot (so the result can be sent), the terminal that ran `takeover`.
#
# Progress: the job writes "done total label" lines to $PROGRESS (render_range.sh does);
# the window reads it every 2 s.
set -uo pipefail
STATE_DIR="$HOME/.cache/takeover"; mkdir -p "$STATE_DIR"
FROZEN="$STATE_DIR/frozen"; PROGRESS="$STATE_DIR/progress"; LABEL_F="$STATE_DIR/label"; PAUSED="$STATE_DIR/paused"
JOB=takeover-job
KEEP_RE='^(init\.scope|takeover|cuteworld-render|perimeter81|.*claude-keep-awake|.*claude-whatsapp.*|.*whatsapp.*|whatclaude|power-menu-rescue|power-profile-auto|ssh-agent|ydotool|snap\.snapd|flatpak-session-helper|language-path|dbus|gnome|org\.|xdg|pipewire|wireplumber|at-spi|gvfs|dconf|evolution|app-gnome-org\.gnome\.(Evolution|SettingsDaemon)|app-gnome-update|app-gnome-perimeter81)'
MY_SCOPE=$(grep -oE '[^/]+\.scope$' /proc/self/cgroup | head -1)

units_to_freeze() {
  systemctl --user list-units --type=service,scope --state=running --no-pager --plain \
    | awk 'NR>1 && $1 ~ /\.(service|scope)$/ {print $1}' \
    | grep -v -E "$KEEP_RE" | grep -v -F "${MY_SCOPE:-__none__}" | grep -v -E "^${JOB}\.service$"
}

cmd=${1:-status}; shift || true
case "$cmd" in
  plan)
    echo "would freeze:"; units_to_freeze | sed 's/^/  /'
    echo "would keep: the desktop, audio, VPN, keep-awake, WhatsApp bridge+bot, this terminal ($MY_SCOPE)"
    ;;
  start)
    label="job"
    if [ "${1:-}" = "-l" ]; then label=$2; shift 2; fi
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || { echo "takeover start [-l label] -- <command...>" >&2; exit 2; }
    if systemctl --user is-active --quiet "$JOB"; then echo "a takeover is already running (takeover status)" >&2; exit 1; fi
    echo "$label" > "$LABEL_F"; : > "$PROGRESS"; rm -f "$PAUSED"
    : > "$FROZEN"
    for u in $(units_to_freeze); do
      systemctl --user freeze "$u" 2>/dev/null && echo "$u" >> "$FROZEN"
    done
    echo "frozen $(wc -l < "$FROZEN") units; starting $label"
    # the job: full priority, its own cgroup, thaws everything when it exits however it exits
    systemd-run --user --unit="$JOB" --collect -p OOMScoreAdjust=300 \
      bash -c 'cd "$1"; shift; "$@"; rc=$?; takeover finish; exit $rc' _ "$PWD" "$@" >/dev/null
    setsid -f "$0" gui >/dev/null 2>&1
    notify-send -i utilities-system-monitor "Takeover: $label" "Everything else is frozen. Ctrl+Alt+P pauses." 2>/dev/null
    ;;
  pause)
    if ! systemctl --user is-active --quiet "$JOB"; then echo "no takeover job running"; exit 1; fi
    if [ -e "$PAUSED" ]; then
      systemctl --user thaw "$JOB" && rm -f "$PAUSED" && notify-send "Takeover resumed" 2>/dev/null; echo resumed
    else
      systemctl --user freeze "$JOB" && touch "$PAUSED" && notify-send "Takeover paused" "Ctrl+Alt+P resumes." 2>/dev/null; echo paused
    fi
    ;;
  finish)
    n=0
    if [ -s "$FROZEN" ]; then
      while read -r u; do [ -n "$u" ] && systemctl --user thaw "$u" 2>/dev/null && n=$((n+1)); done < "$FROZEN"
    fi
    : > "$FROZEN"; rm -f "$PAUSED"
    echo "done" >> "$PROGRESS"
    notify-send -i emblem-ok-symbolic "Takeover finished: $(cat "$LABEL_F" 2>/dev/null)" "Thawed $n programs. The laptop is yours." 2>/dev/null
    echo "thawed $n units"
    ;;
  status)
    if systemctl --user is-active --quiet "$JOB"; then
      echo "job: running ($(cat "$LABEL_F" 2>/dev/null))$( [ -e "$PAUSED" ] && echo ' [PAUSED]')"; tail -1 "$PROGRESS" 2>/dev/null | sed 's/^/progress: /'
    else echo "job: none"; fi
    if [ -s "$FROZEN" ]; then echo "frozen ($(wc -l < "$FROZEN")):"; sed 's/^/  /' "$FROZEN"; else echo "frozen: nothing"; fi
    ;;
  gui)
    exec python3 - "$PROGRESS" "$LABEL_F" "$PAUSED" "$JOB" <<'PY'
"""Black window on every monitor, the progress on the primary one. Closes the moment the job
is gone. GTK 3, because it can place a fullscreen window on a chosen monitor (kipur does
the same)."""
import sys, time, subprocess, os
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango
PROGRESS, LABEL_F, PAUSED, JOB = sys.argv[1:5]
t_start = time.time()
state = {"samples": [], "wins": []}

def running():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", JOB]).returncode == 0

css = Gtk.CssProvider()
css.load_from_data(b"""
window, .black { background-color: #07070a; }
label { color: #ece7d9; }
.big { font-size: 40px; font-weight: 600; }
.mid { font-size: 20px; }
.dim { font-size: 17px; color: #9a958a; }
progressbar trough, progressbar progress { min-height: 26px; }
button { font-size: 18px; padding: 10px 22px; }
""")
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

display = Gdk.Display.get_default()
n = display.get_n_monitors()
primary = display.get_primary_monitor()
prim_idx = 0
for i in range(n):
    if display.get_monitor(i) is primary:
        prim_idx = i
widgets = {}
for i in range(n):
    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("Takeover"); win.set_decorated(False); win.set_keep_above(True)
    win.get_style_context().add_class("black")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
    box.set_valign(Gtk.Align.CENTER); box.set_halign(Gtk.Align.CENTER)
    win.add(box)
    if i == prim_idx:
        title = Gtk.Label(); title.get_style_context().add_class("big"); title.set_xalign(0); box.pack_start(title, False, False, 0)
        bar = Gtk.ProgressBar(); bar.set_show_text(True); bar.set_size_request(820, -1); box.pack_start(bar, False, False, 0)
        info = Gtk.Label(); info.get_style_context().add_class("mid"); info.set_xalign(0); info.set_line_wrap(True); info.set_max_width_chars(70); box.pack_start(info, False, False, 0)
        hint = Gtk.Label(label="The laptop belongs to this job. Everything else is frozen in place: nothing is closed, nothing is lost.\nCtrl+Alt+P pauses and resumes.")
        hint.get_style_context().add_class("dim"); hint.set_xalign(0); hint.set_line_wrap(True); hint.set_max_width_chars(70); box.pack_start(hint, False, False, 0)
        row = Gtk.Box(spacing=14); box.pack_start(row, False, False, 8)
        btn = Gtk.Button(label="Pause  (Ctrl+Alt+P)"); btn.connect("clicked", lambda _b: subprocess.run(["takeover", "pause"])); row.pack_start(btn, False, False, 0)
        stop = Gtk.Button(label="Stop and give the laptop back"); stop.get_style_context().add_class("destructive-action")
        def on_stop(_b):
            subprocess.run(["systemctl", "--user", "stop", JOB]); subprocess.run(["takeover", "finish"]); Gtk.main_quit()
        stop.connect("clicked", on_stop); row.pack_start(stop, False, False, 0)
        widgets = {"title": title, "bar": bar, "info": info, "btn": btn}
    else:
        lab = Gtk.Label(label="working, see the main screen"); lab.get_style_context().add_class("dim"); box.pack_start(lab, False, False, 0)
    win.connect("delete-event", lambda *_: True)
    win.show_all()
    win.fullscreen_on_monitor(Gdk.Screen.get_default(), i)
    win.fullscreen()
    state["wins"].append(win)

def tick():
    if not running():
        Gtk.main_quit(); return False
    try: label = open(LABEL_F).read().strip()
    except OSError: label = "job"
    paused = os.path.exists(PAUSED)
    widgets["title"].set_text(("PAUSED: " if paused else "Working: ") + label)
    widgets["btn"].set_label(("Resume" if paused else "Pause") + "  (Ctrl+Alt+P)")
    last = ""
    try:
        lines = [l for l in open(PROGRESS).read().splitlines() if l.strip() and l.strip() != "done"]
        last = lines[-1] if lines else ""
    except OSError: pass
    parts = last.split()
    bar, info = widgets["bar"], widgets["info"]
    el = time.time() - t_start
    if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
        done, total = int(parts[0]), int(parts[1])
        bar.set_fraction(done / max(1, total)); bar.set_text(f"{done} / {total}  " + " ".join(parts[2:]))
        now = time.time(); samp = state["samples"]
        if not samp or samp[-1][1] != done: samp.append((now, done))
        samp[:] = [x for x in samp if now - x[0] <= 300] or samp[-1:]
        if paused:
            info.set_text(f"{int(el//60)} min in. Paused.")
        elif len(samp) >= 2 and samp[-1][1] > samp[0][1]:
            rate = (samp[-1][1] - samp[0][1]) / max(1e-6, samp[-1][0] - samp[0][0])
            left = (total - done) / rate
            info.set_text(f"{int(el//60)} min in. About {int(left//60)} min left at this pace, done around {time.strftime('%H:%M', time.localtime(now + left))}.")
        else:
            info.set_text(f"{int(el//60)} min in. Measuring the pace...")
    else:
        bar.pulse(); bar.set_text("working"); info.set_text(f"{int(el//60)} min in. No progress numbers from this job yet.")
    return True

tick(); GLib.timeout_add(2000, tick)
Gtk.main()
PY
    ;;
  *) sed -n '2,22p' "$0" | sed 's/^# \?//'; exit 2 ;;
esac
