#!/usr/bin/env bash
# claude-whatsapp-doctor: keeps the "My Claude" WhatsApp bot alive.
#
# Why this exists: on 2026-07-21 the bot had been dead for hours. The project
# directory was moved (~/code/claude-whatsapp-bot -> ~/code/claude-stuff/...),
# which left the systemd unit symlink dangling. Because the *unit file itself*
# was gone, Restart=always could not help: systemd logged
# "Failed to schedule restart job: Unit not found" and gave up. The restart
# counter reached 6619 and nothing ever told the user. Messages sent to the
# group were silently ignored.
#
# So this script does not trust any hardcoded path. It locates bot.py wherever
# it currently lives, rewrites the unit if it points somewhere stale, repairs
# the wa-history symlink, and restarts the service. If it cannot fix things it
# shouts (desktop notification) instead of failing quietly.
#
# 2026-08-06: it happened again, for a completely different reason, and this
# script reported "healthy" throughout. WhatsApp unlinked the device at 19:49
# ("Got device removed stream error"); the bridge process stayed up and the bot
# stayed up, both perfectly idle, because a linked device is not the same thing
# as a running process. Nothing noticed for an hour, and only the user did.
# So checks 4b/4c below look at the *link*: is this device still paired, and is
# the socket actually connected. Losing the pairing needs a phone to fix it, so
# the repair is to put the QR on screen and say so, loudly, until it is scanned.
#
# Run by claude-whatsapp-doctor.timer every 5 minutes, and once at boot.

set -uo pipefail

# The repair paths below shell out to wa-reconnect / notify-send. A watchdog
# that cannot find its own tools is worse than none, so do not rely on whatever
# PATH the service happens to inherit.
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

UNIT=claude-whatsapp.service
UNIT_DIR="$HOME/.config/systemd/user"
UNIT_PATH="$UNIT_DIR/$UNIT"
STATE_DIR="$HOME/.config/claude-whatsapp"
LOG="$STATE_DIR/doctor.log"
BRIDGE_UNIT=whatsapp-bridge.service

mkdir -p "$STATE_DIR" "$UNIT_DIR"

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# Keep the log from growing forever.
if [[ -f "$LOG" ]] && [[ $(stat -c%s "$LOG" 2>/dev/null || echo 0) -gt 1000000 ]]; then
    tail -n 2000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

notify() {
    log "NOTIFY: $*"
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -u critical "Claude WhatsApp bot" "$*" 2>/dev/null
}

# --- 1. Find bot.py, wherever it lives now -----------------------------------
# Ordered guesses first (cheap), then a bounded search under ~/code (robust to
# any future reorganisation).
find_bot() {
    local c
    for c in \
        "$HOME/code/claude-stuff/claude-whatsapp-bot/bot.py" \
        "$HOME/code/claude-whatsapp-bot/bot.py"
    do
        [[ -f "$c" ]] && { printf '%s' "$c"; return 0; }
    done
    c=$(find "$HOME/code" -maxdepth 4 -type f -path '*claude-whatsapp-bot/bot.py' \
            -not -path '*/.claude/worktrees/*' -not -path '*/node_modules/*' \
            2>/dev/null | head -n1)
    [[ -n "$c" ]] && { printf '%s' "$c"; return 0; }
    return 1
}

BOT_PY=$(find_bot) || {
    notify "Cannot find bot.py anywhere under ~/code. The bot is DOWN and I cannot repair it."
    exit 1
}
BOT_DIR=$(dirname "$BOT_PY")

# --- 2. Make sure the unit exists and points at the real bot.py --------------
need_reload=0

# A dangling symlink is the exact failure we are guarding against: -f is false
# for it, so this branch catches both "missing" and "points into the void".
if [[ ! -f "$UNIT_PATH" ]]; then
    [[ -L "$UNIT_PATH" ]] && { rm -f "$UNIT_PATH"; log "removed dangling unit symlink"; }
    src="$BOT_DIR/$UNIT"
    if [[ -f "$src" ]]; then
        # Install a real copy, not a symlink. A symlink into the project dir is
        # what broke last time; a copy survives the directory moving again.
        install -m 644 "$src" "$UNIT_PATH"
        log "unit was missing; installed copy from $src"
    else
        cat >"$UNIT_PATH" <<EOF
[Unit]
Description=Claude WhatsApp bot: replies to the "My Claude" self-group via the whatsapp-mcp bridge
After=network-online.target $BRIDGE_UNIT
Wants=network-online.target $BRIDGE_UNIT

[Service]
Type=simple
WorkingDirectory=$HOME
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 $BOT_PY
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
EOF
        log "unit was missing and no template found; generated one"
    fi
    need_reload=1
fi

# Unit exists but ExecStart may reference a stale bot.py path.
cur_exec=$(grep -m1 '^ExecStart=' "$UNIT_PATH" 2>/dev/null || true)
if [[ -n "$cur_exec" && "$cur_exec" != *"$BOT_PY"* ]]; then
    sed -i "s|^ExecStart=.*|ExecStart=/usr/bin/python3 $BOT_PY|" "$UNIT_PATH"
    log "ExecStart was stale ($cur_exec) -> now $BOT_PY"
    need_reload=1
fi

# Keep the project's own copy of the unit correct too, so a future reinstall
# from the repo does not reintroduce the stale path.
proj_unit="$BOT_DIR/$UNIT"
if [[ -f "$proj_unit" ]] && ! grep -q "ExecStart=.*$BOT_PY" "$proj_unit"; then
    sed -i "s|^ExecStart=.*|ExecStart=/usr/bin/python3 $BOT_PY|" "$proj_unit"
    log "fixed stale ExecStart in project unit $proj_unit"
fi

# --- 3. Repair helper symlinks the bot shells out to -------------------------
# wa-history broke the same way; a dangling link only degrades the bot (it logs
# WARN and loses conversation history), so it never announced itself.
for helper in wa-history; do
    link="$HOME/.local/bin/$helper"
    target="$BOT_DIR/$helper"
    if [[ -f "$target" ]] && [[ ! -e "$link" || "$(readlink -f "$link" 2>/dev/null)" != "$target" ]]; then
        ln -sfn "$target" "$link"
        log "repaired $helper symlink -> $target"
    fi
done

(( need_reload )) && { systemctl --user daemon-reload; log "daemon-reload"; }

# --- 4. Ensure enabled, and the bridge it depends on is up -------------------
if ! systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then
    systemctl --user enable "$UNIT" >/dev/null 2>&1 && log "re-enabled $UNIT"
fi

if ! systemctl --user is-active --quiet "$BRIDGE_UNIT" 2>/dev/null; then
    log "bridge down; starting $BRIDGE_UNIT"
    systemctl --user start "$BRIDGE_UNIT" 2>/dev/null
    sleep 5
fi

# --- 4b. Link health --------------------------------------------------------
# The failure this section exists for: WhatsApp drops the pairing (device
# removed on the phone, or the ~2-week linked-device expiry) and every layer
# above keeps looking fine. Only the link state tells the truth.
WA_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/whatsapp-claude"
RECONNECT_LOCK="$WA_STATE/reconnect.lock"
LINK_ALERT="$STATE_DIR/.link-alert"        # epoch of last "go scan" shout
DISCONNECT_MARK="$STATE_DIR/.disconnected" # consecutive not-connected checks
ALERT_EVERY=1800                           # re-shout every 30 min while unlinked

find_bridge_dir() {
    local d
    for d in "$HOME/code/whatsapp-mcp/whatsapp-bridge" \
             "$HOME/code/claude-stuff/whatsapp-mcp/whatsapp-bridge"; do
        [[ -d "$d" ]] && { printf '%s' "$d"; return 0; }
    done
    d=$(find "$HOME/code" -maxdepth 4 -type d -name whatsapp-bridge 2>/dev/null | head -n1)
    [[ -n "$d" ]] && { printf '%s' "$d"; return 0; }
    return 1
}
BRIDGE_DIR=$(find_bridge_dir || true)

# A linking session in progress owns the bridge: leave it alone, and do not
# stack a second QR window on top of the one already waiting to be scanned.
relinking() {
    [[ -f "$RECONNECT_LOCK" ]] || return 1
    ! flock -n "$RECONNECT_LOCK" true 2>/dev/null
}

# Authoritative pairing check straight from whatsmeow's own store: it deletes
# the device row on logout. Works even against an old bridge build with no
# /api/status. Echoes yes/no/unknown.
device_paired() {
    local db="$BRIDGE_DIR/store/whatsapp.db"
    [[ -f "$db" ]] || { echo unknown; return; }
    python3 - "$db" <<'PY' 2>/dev/null || echo unknown
import sqlite3, sys
try:
    c = sqlite3.connect('file:%s?mode=ro' % sys.argv[1], uri=True)
    n = c.execute('select count(*) from whatsmeow_device').fetchone()[0]
    print('yes' if n else 'no')
except Exception:
    print('unknown')
PY
}

api_status=$(curl -s --max-time 4 http://localhost:8080/api/status 2>/dev/null || true)
api_logged_in=""; api_connected=""
if [[ -n "$api_status" ]]; then
    api_logged_in=$(grep -o '"logged_in":[a-z]*' <<<"$api_status" | cut -d: -f2)
    api_connected=$(grep -o '"connected":[a-z]*' <<<"$api_status" | cut -d: -f2)
fi

paired=$(device_paired)
[[ -n "$BRIDGE_DIR" && -f "$BRIDGE_DIR/store/logged_out.flag" ]] && paired=no
[[ "$api_logged_in" == "false" ]] && paired=no

if relinking; then
    log "a linking session is in progress; skipping link checks"
elif [[ "$paired" == "no" ]]; then
    # Unlinked. Only a phone can fix this, so put the QR on screen and shout.
    now=$(date +%s)
    last=$(cat "$LINK_ALERT" 2>/dev/null || echo 0)
    [[ "$last" =~ ^[0-9]+$ ]] || last=0
    if (( now - last >= ALERT_EVERY )); then
        printf '%s' "$now" >"$LINK_ALERT"
        notify "WhatsApp unlinked this device. The bot cannot see or send anything. Scan the QR window that just opened (WhatsApp → Linked devices)."
        log "UNLINKED: launching wa-reconnect for a QR scan"
        if command -v wa-reconnect >/dev/null 2>&1; then
            setsid -f nohup wa-reconnect >>"$WA_STATE/reconnect.log" 2>&1 </dev/null || \
                notify "Could not launch wa-reconnect. Run it in a terminal: wa-reconnect"
        else
            notify "wa-reconnect is missing. Re-link by hand from $BRIDGE_DIR"
        fi
    else
        log "UNLINKED (alerted $((now - last))s ago; waiting for the scan)"
    fi
elif [[ -n "$api_status" && "$api_connected" == "false" ]]; then
    # Paired but the socket is down. One flap is normal; two checks in a row
    # (10 minutes deaf) is not, so bounce the bridge and escalate if that fails.
    n=$(cat "$DISCONNECT_MARK" 2>/dev/null || echo 0)
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    n=$((n + 1)); printf '%s' "$n" >"$DISCONNECT_MARK"
    log "bridge paired but not connected (strike $n)"
    if (( n >= 2 )); then
        log "restarting $BRIDGE_UNIT to force a reconnect"
        systemctl --user restart "$BRIDGE_UNIT" 2>/dev/null
        sleep 8
        after=$(curl -s --max-time 4 http://localhost:8080/api/status 2>/dev/null || true)
        if grep -q '"connected":true' <<<"$after"; then
            log "bridge reconnected"
            printf '0' >"$DISCONNECT_MARK"
        else
            notify "WhatsApp bridge is paired but will not connect. Messages are not getting through."
        fi
    fi
elif [[ -z "$api_status" ]] && systemctl --user is-active --quiet "$BRIDGE_UNIT" 2>/dev/null; then
    # Process alive, REST port dead: an old build without /api/status, or a
    # wedged listener. Distinguish with the send endpoint before restarting.
    if curl -s --max-time 4 -o /dev/null http://localhost:8080/api/send 2>/dev/null; then
        log "bridge REST up but /api/status missing; rebuild it (wa-bridge-ctl build)"
        printf '0' >"$DISCONNECT_MARK"
    else
        n=$(cat "$DISCONNECT_MARK" 2>/dev/null || echo 0)
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        n=$((n + 1)); printf '%s' "$n" >"$DISCONNECT_MARK"
        log "bridge running but REST :8080 is dead (strike $n)"
        if (( n >= 2 )); then
            log "restarting $BRIDGE_UNIT (dead REST port)"
            systemctl --user restart "$BRIDGE_UNIT" 2>/dev/null
            printf '0' >"$DISCONNECT_MARK"
        fi
    fi
else
    # Healthy: clear both counters so a future incident starts from zero.
    printf '0' >"$DISCONNECT_MARK"
    rm -f "$LINK_ALERT"
fi

# --- 5. Ensure the bot is actually running ----------------------------------
if ! systemctl --user is-active --quiet "$UNIT"; then
    log "bot not active; starting"
    systemctl --user reset-failed "$UNIT" 2>/dev/null
    if systemctl --user start "$UNIT" 2>/dev/null; then
        sleep 3
        if systemctl --user is-active --quiet "$UNIT"; then
            log "bot recovered"
        else
            notify "Bot is down and would not start. Run: journalctl --user -u $UNIT -n 50"
        fi
    else
        notify "Bot is down and 'systemctl start' failed. Run: journalctl --user -u $UNIT -n 50"
    fi
fi

# --- 6. Flap detection ------------------------------------------------------
# Active-but-crash-looping looks healthy to is-active. Catch the case where the
# bot restarts over and over (bad import, bridge schema change) and say so.
nrestarts=$(systemctl --user show -p NRestarts --value "$UNIT" 2>/dev/null || echo 0)
mark="$STATE_DIR/.doctor-nrestarts"
prev=$(cat "$mark" 2>/dev/null || echo 0)
printf '%s' "$nrestarts" >"$mark"
if [[ "$nrestarts" =~ ^[0-9]+$ && "$prev" =~ ^[0-9]+$ ]] && (( nrestarts - prev > 5 )); then
    notify "Bot is crash-looping ($((nrestarts - prev)) restarts since last check). Messages may be missed."
    log "FLAPPING: $prev -> $nrestarts"
fi

# --- 7. Keep the full-tools assist timer armed ------------------------------
# wa-assist promises someone "he answers you every 5 minutes". A timer that
# quietly stopped looks, from their side, exactly like being ignored. So while
# the registry still lists an enabled chat, the timer has to be running.
ASSIST_REG="$STATE_DIR/assist.json"
ASSIST_TIMER=claude-wa-assist.timer
if [[ -s "$ASSIST_REG" ]] && grep -q '"enabled"[[:space:]]*:[[:space:]]*true' "$ASSIST_REG"; then
    if ! systemctl --user is-active --quiet "$ASSIST_TIMER" 2>/dev/null; then
        log "assist timer down while chats are armed; starting"
        systemctl --user enable --now "$ASSIST_TIMER" >/dev/null 2>&1 \
            && log "assist timer recovered" \
            || notify "wa-assist chats are armed but $ASSIST_TIMER will not start."
    fi
fi

exit 0
