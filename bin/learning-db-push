#!/usr/bin/env python3
"""learning-db-push: copy the learning app's DB to the server every hour.

The WhatsApp auto-reply monitor (monitor.py + facts.py) runs on the server since
2026-09-25 and reads his exam/deadline schedule from ~/code/learning/data/learning.db.
The learning app itself stays on the laptop, so a consistent snapshot (sqlite
backup API, the DB is in WAL mode) is pushed across by learning-db-push.timer.
"""
import os, sqlite3, subprocess, sys, tempfile

SRC = os.path.expanduser("~/code/learning/data/learning.db")
DST = "code/learning/data/learning.db"
if not os.path.exists(SRC):
    sys.exit("learning-db-push: no " + SRC)
fd, tmp = tempfile.mkstemp(suffix=".db", prefix="learning-push-")
os.close(fd)
try:
    src = sqlite3.connect("file:%s?mode=ro" % SRC, uri=True, timeout=30)
    dst = sqlite3.connect(tmp)
    src.backup(dst)
    dst.close(); src.close()
    subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "server",
                    "mkdir -p code/learning/data"], check=True, timeout=60)
    subprocess.run(["rsync", "-t", "--timeout=120", tmp, "server:" + DST],
                   check=True, timeout=600)
finally:
    os.unlink(tmp)
