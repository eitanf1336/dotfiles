#!/usr/bin/env python3
"""deed-creds-guard - keep a usable copy of the deed Claude login, and put it
back when Claude Code throws its own away.

Claude Code rotates the OAuth refresh token on every refresh, and two of its
processes can try to refresh at the same moment (a daemon restarting for a
version upgrade, plus the session already running). One of them wins and writes
the new token; the loser gets invalid_grant and answers by BLANKING
.credentials.json, which destroys the winner's perfectly good token and demands
a browser login. That happened twice to the deed account on 2026-09-12.

The main account survives this because `claude-account sync` parks its live
token every 10 minutes, so a wipe is one `claude-account use` away. The deed
config had no such copy. This is that copy, plus the restore.

Every tick:
  live has a token   -> park it in the deed slot if the slot is out of date
  live is blank      -> put the slot's token back, once
  restore didn't take -> remember that token as dead and stop trying, because
                         at that point only a real `/login` can help

It never parks a blank file over a good one, which is the one way a naive
"just copy it every minute" would make things worse.
"""
import hashlib
import json
import os
import shutil
import sys
import time

DEED = os.path.expanduser("~/.claude-deed")
LIVE = os.path.join(DEED, ".credentials.json")
SLOT_DIR = os.path.expanduser("~/.claude/accounts/deed")
SLOT = os.path.join(SLOT_DIR, "credentials.json")
STATE = os.path.join(SLOT_DIR, ".guard-state.json")


def log(msg):
    print(f"deed-creds-guard: {msg}", flush=True)


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def token(doc):
    """The refresh token in a credentials document, or '' if there is none."""
    if not isinstance(doc, dict):
        return ""
    oauth = doc.get("claudeAiOauth", doc)
    if not isinstance(oauth, dict):
        return ""
    return str(oauth.get("refreshToken") or "")


def fingerprint(tok):
    """A token is a secret, and the state file has no business holding a second
    copy of one. Compare fingerprints instead."""
    return hashlib.sha256(tok.encode()).hexdigest()[:16] if tok else ""


def copy(src, dst):
    """Copy credentials with the same permissions Claude uses, atomically."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.{os.getpid()}.tmp"
    shutil.copyfile(src, tmp)
    os.chmod(tmp, 0o600)
    os.replace(tmp, dst)


def state():
    return read(STATE) or {}


def save_state(**kw):
    tmp = f"{STATE}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(kw, fh, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE)


def main():
    if not os.path.isdir(DEED):
        return 0
    live_tok = token(read(LIVE))
    slot_tok = token(read(SLOT))

    if live_tok:
        # Healthy. Keep the parked copy current, and forget any dead-token note
        # for a token that is no longer the one in play.
        if live_tok != slot_tok:
            copy(LIVE, SLOT)
            log("parked a fresh deed token")
        st = state()
        if st.get("restored") and st["restored"] != fingerprint(live_tok):
            save_state()
        return 0

    if not os.path.isfile(LIVE):
        return 0                      # no deed login at all: nothing to guard
    st = state()
    if st.get("restored") == fingerprint(slot_tok):
        # We already put this exact token back and Claude blanked it again, so
        # the token really is dead and only a browser login can fix it.
        if not st.get("announced"):
            save_state(restored=fingerprint(slot_tok), announced=True)
            log("deed login is blank and the parked token is dead too: "
                "run `/login` in a deed chat")
        return 1
    if not slot_tok:
        log("deed login is blank and no parked token exists: "
            "run `/login` in a deed chat")
        return 1
    copy(SLOT, LIVE)
    save_state(restored=fingerprint(slot_tok),
                   at=time.strftime("%Y-%m-%dT%H:%M:%S"))
    log("deed login was blank: restored the parked token")
    return 0


if __name__ == "__main__":
    sys.exit(main())
