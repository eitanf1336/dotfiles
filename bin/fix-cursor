#!/usr/bin/env python3
"""fix-cursor: the mouse pointer is gone from the main screen. What now?

When it happens: on wake from sleep. During the resume the NVIDIA card cannot
take the cursor image yet (its video memory is still being restored by
nvidia-resume.service), so the first upload fails --

    nvidia-drm: Failed to map NvKmsKapiMemory
    gnome-shell: Realizing HW cursor failed: Failed write to gbm_bo: Cannot allocate memory
    gnome-shell: Failed to set hardware cursor (...), using OpenGL from now on

mutter then keeps that fallback for the rest of the session, and it does not draw
the pointer on HDMI-1, the only screen wired to the NVIDIA card. The Intel-driven
screens (eDP-1, dock DP-8/DP-9) keep their pointer, which is why only one screen
looks broken.

Nothing clears that latch from outside the compositor. Tested and useless:
Super+F5 (fix-screen), nudging cursor-size or the cursor theme, and forcing a
modeset on the screen. Only restarting gnome-shell brings the pointer back, and
on Wayland that means logging out.

Usage:
    fix-cursor            diagnose: is the GPU healthy again, and what to do
    fix-cursor --nudge    re-realize the cursor sprite (harmless, rarely enough)
    fix-cursor --blink    force a modeset on the primary screen (did not help in
                          the 2026-08-16 case, kept for a different flavour)
    fix-cursor --logout   log out now, which is the actual cure
"""

import ctypes
import os
import subprocess
import sys
import time

ARGB8888 = 0x34325241                      # fourcc, the format mutter uses for cursors
USE_CURSOR, USE_WRITE = 1 << 1, 1 << 3


def gpu_can_take_a_cursor(path="/dev/dri/card2"):
    """Redo mutter's failing call: create a cursor buffer and write to it."""
    gbm = ctypes.CDLL("libgbm.so.1", use_errno=True)
    gbm.gbm_create_device.restype = ctypes.c_void_p
    gbm.gbm_create_device.argtypes = [ctypes.c_int]
    gbm.gbm_bo_create.restype = ctypes.c_void_p
    gbm.gbm_bo_create.argtypes = [ctypes.c_void_p] + [ctypes.c_uint32] * 4
    gbm.gbm_bo_write.restype = ctypes.c_int
    gbm.gbm_bo_write.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
    gbm.gbm_bo_destroy.argtypes = [ctypes.c_void_p]

    try:
        fd = os.open(path, os.O_RDWR)
    except OSError as err:
        return None, f"cannot open {path}: {err}"
    try:
        dev = gbm.gbm_create_device(fd)
        if not dev:
            return None, f"gbm_create_device failed on {path}"
        size = 256
        bo = gbm.gbm_bo_create(dev, size, size, ARGB8888, USE_CURSOR | USE_WRITE)
        if not bo:
            return False, f"gbm_bo_create failed ({os.strerror(ctypes.get_errno())})"
        pixels = (ctypes.c_uint8 * (size * size * 4))()
        ctypes.set_errno(0)
        rc = gbm.gbm_bo_write(bo, pixels, size * size * 4)
        err = ctypes.get_errno()
        gbm.gbm_bo_destroy(bo)
        if rc != 0:
            return False, f"gbm_bo_write failed ({os.strerror(err)})"
        return True, "cursor buffer allocated and written"
    finally:
        os.close(fd)


def journal_hit():
    out = subprocess.run(["journalctl", "-b", "--no-pager"],
                         capture_output=True, text=True).stdout
    return [line for line in out.splitlines()
            if "Realizing HW cursor failed" in line or "NvKmsKapiMemory" in line]


def nudge():
    key = ["gsettings", "get", "org.gnome.desktop.interface", "cursor-size"]
    size = int(subprocess.run(key, capture_output=True, text=True, check=True).stdout)
    for value in (size + 1, size):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                        "cursor-size", str(value)], check=True)
        time.sleep(1)
    print(f"cursor sprite re-realized (size {size})")


def blink():
    import gi
    from gi.repository import Gio, GLib

    iface = "org.gnome.Mutter.DisplayConfig"
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    p = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, iface,
                               "/org/gnome/Mutter/DisplayConfig", iface, None)

    def state():
        return p.call_sync("GetCurrentState", None, Gio.DBusCallFlags.NONE, -1, None).unpack()

    def current_modes():
        _, monitors, _, _ = state()
        return {m[0][0]: mode[0] for m in monitors for mode in m[1] if mode[6].get("is-current")}

    def apply(override):
        serial, _mons, logical, _props = state()
        cur = current_modes()
        lms = [(x, y, scale, transform, primary,
                [(mon[0], override.get(mon[0], cur.get(mon[0])), {}) for mon in mons])
               for x, y, scale, transform, primary, mons, _lp in logical]
        # method 1 = temporary: GNOME puts the old mode back by itself after ~20s
        args = GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})",
                            (serial, 1, lms, {"layout-mode": GLib.Variant("u", 1)}))
        p.call_sync("ApplyMonitorsConfig", args, Gio.DBusCallFlags.NONE, -1, None)

    _serial, monitors, logical, _props = state()
    primary = next((mons[0][0] for *_r, pr, mons, _lp in logical if pr), None)
    modes = next((m[1] for m in monitors if m[0][0] == primary), [])
    cur = next((m for m in modes if m[6].get("is-current")), None)
    alt = next((m[0] for m in modes
                if cur and m[1] == cur[1] and m[2] == cur[2] and m[0] != cur[0]), None)
    if not (primary and cur and alt):
        print("no second refresh rate on the primary screen, nothing to blink")
        return
    print(f"{primary}: {cur[0]} -> {alt} -> {cur[0]}")
    apply({primary: alt})
    time.sleep(5)
    apply({primary: cur[0]})


def logout():
    print("logging out in 5s, Ctrl+C to abort", flush=True)
    time.sleep(5)
    subprocess.run(["gnome-session-quit", "--logout", "--no-prompt"])


def diagnose():
    hits = journal_hit()
    if hits:
        print("this boot hit the cursor-upload failure:")
        for line in hits[-3:]:
            print("   ", line.strip())
    else:
        print("no cursor-upload failure in this boot's journal, so this is "
              "something else. Look for 'cursor' in journalctl -b.")

    ok, detail = gpu_can_take_a_cursor()
    if ok is None:
        print(f"could not probe the GPU: {detail}")
    elif ok:
        print(f"NVIDIA card is healthy again now ({detail}).")
        print("=> the compositor latched the failure, the GPU did not. "
              "Log out and back in and the pointer returns: fix-cursor --logout")
    else:
        print(f"NVIDIA card still cannot take a cursor ({detail}).")
        print("=> a re-login will not be enough, reboot.")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--nudge":
        nudge()
    elif arg == "--blink":
        blink()
    elif arg == "--logout":
        logout()
    elif arg in ("", "--diagnose"):
        diagnose()
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
