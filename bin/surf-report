    data:{labels:days.map(d=>d.dayLabel==='Today'?'Today':d.dow),
      datasets:[{data:days.map(d=>d.rating),borderColor:'#0d94c9',borderWidth:2.4,
        tension:.35,fill:true,backgroundColor:'rgba(13,148,201,.12)',
        pointRadius:4,pointBackgroundColor:days.map(d=>rcolor(d.rating)),
        pointBorderColor:'#fff',pointBorderWidth:1.5}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{enabled:false}},
      scales:{x:{grid:{display:false},ticks:{color:'#5a6b7b',font:{size:11,weight:'700'}}},
