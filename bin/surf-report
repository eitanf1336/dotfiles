#!/usr/bin/env python3
"""surf-report — build a week-ahead surf PDF and send it to WhatsApp.

Renders the full forecast (high-level display + week Morning/Afternoon table +
week-trend chart + an hourly rating chart for every day) to an A4 PDF via
headless Chrome, then posts it to a WhatsApp group through the local bridge's
`/api/send` REST endpoint.

Runs once a day. A systemd user timer with Persistent=true fires it at a set
time and *catches up on the next boot if the machine was off* — so if the PC was
disconnected the report still goes out. A last-sent-date guard makes it
idempotent (at most one report per day) no matter how often it's triggered.

Usage:
  surf-report             # send today's report unless one already went out today
  surf-report --force     # build + send now, ignore the once-a-day guard
  surf-report --pdf-only  # just build the PDF, print its path, don't send
"""
import os, sys, json, time, subprocess, datetime as dt, sqlite3
import urllib.request, urllib.error

SURF_DIR = os.path.expanduser('~/code/claude-stuff/surf-desktop')
sys.path.insert(0, SURF_DIR)
try:
    import surffeed
except ImportError:
    # the repo moved once already and this timer died quietly for weeks; a
    # daily job that fails should say which path it wanted.
    sys.exit('surf-report: no surffeed under %s — the repo moved, fix SURF_DIR'
             % SURF_DIR)

CHARTJS = os.path.join(SURF_DIR, 'vendor', 'chart.umd.min.js')
STATE = os.path.expanduser('~/.local/state/surf')
REPORTS = os.path.join(STATE, 'reports')
LAST_SENT = os.path.join(STATE, 'last_report.txt')

BRIDGE_URL = 'http://localhost:8080/api/send'
BRIDGE_DB = os.path.expanduser(
    '~/code/whatsapp-mcp/whatsapp-bridge/store/messages.db')

RATING_COLORS = {'Poor': '#e5484d', 'Fair': '#e0a020',
                 'Good': '#12a150', 'Perfect': '#0aa5c4'}


# --------------------------------------------------------------- group lookup
def resolve_group_jid(cfg):
    """Prefer an explicit jid in config, else look the group name up in the
    bridge's chat list (the group needs ≥1 message before the bridge knows it)."""
    jid = cfg.get('whatsapp_group_jid')
    if jid:
        return jid
    name = cfg.get('whatsapp_group', 'Surf Status')
    try:
        con = sqlite3.connect('file:%s?mode=ro' % BRIDGE_DB, uri=True)
        row = con.execute(
            'SELECT jid FROM chats WHERE name=? ORDER BY last_message_time DESC '
            'LIMIT 1', (name,)).fetchone()
        con.close()
        return row[0] if row else None
    except Exception as e:
        print('group lookup failed:', e, file=sys.stderr)
        return None


# --------------------------------------------------------------- html builder
def _rc(label):
    return RATING_COLORS.get(label, '#888')


def build_html(snap):
    with open(CHARTJS) as f:
        chartjs = f.read()
    beach = snap.get('beach', {})
    days = snap.get('days', [])
    today = days[0] if days else None
    best = snap.get('best')

    d0 = dt.date.fromisoformat(days[0]['date']) if days else dt.date.today()
    d1 = dt.date.fromisoformat(days[-1]['date']) if days else d0
    span = '%s – %s' % (d0.strftime('%b %-d'), d1.strftime('%b %-d, %Y'))
    gen = dt.datetime.now().strftime('%a %-d %b %Y, %H:%M')

    def sess_cell(s):
        if not s:
            return '<td class="sess"><span class="dash">—</span></td>'
        return ('<td class="sess"><div class="rr" style="color:%s">%s <b>(%d)</b>'
                '</div><div class="bl">%s</div><div class="wnd">%s %d km/h · %s</div>'
                '</td>') % (_rc(s['label']), s['label'], round(s['rating']),
                            s['blurb'], s['windCompass'], s['wind'], s['windKind'])

    rows = ''
    for d in days:
        day_full = dt.date.fromisoformat(d['date']).strftime('%a, %b %-d')
        tag = ('<span class="today">TODAY</span>' if d['dayLabel'] == 'Today'
               else '<span class="tmrw">TMRW</span>' if d['dayLabel'] == 'Tomorrow'
               else '')
        rows += ('<tr><td class="day"><div class="dn">%s</div>%s</td>%s%s'
                 '<td class="num">%.1f m</td><td class="num">%d°C</td></tr>') % (
            day_full, tag, sess_cell(d['am']), sess_cell(d['pm']),
            d['waveMax'], round(d['water']))

    cards = ''
    for i, d in enumerate(days):
        day_full = dt.date.fromisoformat(d['date']).strftime('%a · %b %-d')
        cards += ('<div class="daycard"><div class="dch"><span class="dcttl">%s</span>'
                  '<span class="dcr" style="color:%s">%s (%d)</span></div>'
                  '<div class="mini"><canvas id="c%d"></canvas></div></div>') % (
            day_full, _rc(d['label']), d['label'], round(d['rating']), i)

    hero = ''
    if today:
        hero = ('<div class="today-rating" style="color:%s">%s <span>(%d)</span></div>'
                '<div class="today-blurb">%s</div>'
                '<div class="today-meta">🌊 up to %.1f m &nbsp;·&nbsp; 🌡️ water %d°C '
                '&nbsp;·&nbsp; ⏱️ best window %s</div>') % (
            _rc(today['label']), today['label'], round(today['rating']),
            today['blurb'], today['waveMax'], round(today['water']),
            today['bestWindow'])
    bestline = ''
    if best:
        when = dt.date.fromisoformat(best['date']).strftime('%A')
        bestline = ('<div class="best">★ Best day this week: <b>%s</b> — '
                    '<span style="color:%s">%s (%d)</span></div>') % (
            when, _rc(best['label']), best['label'], round(best['rating']))

    html = _REPORT_TEMPLATE
    html = html.replace('/*__CHARTJS__*/', chartjs)
    html = html.replace('/*__SNAPSHOT__*/', json.dumps(snap))
    html = html.replace('<!--SPAN-->', span)
    html = html.replace('<!--GEN-->', gen)
    html = html.replace('<!--BEACH-->', '%s, %s' % (beach.get('name', 'Poleg Beach'),
                                                     beach.get('sub', 'Netanya')))
    html = html.replace('<!--HERO-->', hero)
    html = html.replace('<!--BEST-->', bestline)
    html = html.replace('<!--ROWS-->', rows)
    html = html.replace('<!--CARDS-->', cards)
    return html


# ------------------------------------------------------------------- render
def _find_chrome():
    for c in ('google-chrome', 'google-chrome-stable', 'chromium', 'chromium-browser'):
        p = subprocess.run(['which', c], capture_output=True, text=True)
        if p.returncode == 0:
            return p.stdout.strip()
    raise RuntimeError('no chrome/chromium found for PDF rendering')


def build_pdf(snap):
    os.makedirs(REPORTS, exist_ok=True)
    html = build_html(snap)
    stamp = dt.date.today().strftime('%Y%m%d')
    html_path = os.path.join(REPORTS, '.report.html')
    pdf_path = os.path.join(REPORTS, 'Poleg_Surf_Forecast_%s.pdf' % stamp)
    with open(html_path, 'w') as f:
        f.write(html)
    cmd = [_find_chrome(), '--headless=new', '--disable-gpu', '--no-sandbox',
           '--no-pdf-header-footer', '--run-all-compositor-stages-before-draw',
           '--virtual-time-budget=8000',
           '--print-to-pdf=' + pdf_path, 'file://' + html_path]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=90, check=True)
    if not os.path.isfile(pdf_path) or os.path.getsize(pdf_path) < 1000:
        raise RuntimeError('PDF render produced no/empty file')
    return pdf_path


# --------------------------------------------------------------------- send
def _bridge_up():
    try:
        urllib.request.urlopen(BRIDGE_URL, data=b'{}', timeout=4)
        return True
    except urllib.error.HTTPError:
        return True                       # 400/405 = alive and answering
    except Exception:
        return False


def wait_for_bridge(secs=90):
    end = time.time() + secs
    while time.time() < end:
        if _bridge_up():
            return True
        time.sleep(3)
    return False


def send_file(jid, path, caption):
    payload = json.dumps({'recipient': jid, 'media_path': path,
                          'message': caption}).encode()
    req = urllib.request.Request(BRIDGE_URL, data=payload,
                                 headers={'Content-Type': 'application/json'})
    with urllib.request.urlopen(req, timeout=60) as r:
        body = json.loads(r.read().decode())
    return bool(body.get('success')), body.get('message', '')


def caption_for(snap):
    b = snap.get('beach', {})
    days = snap.get('days', [])
    best = snap.get('best')
    lines = ['🏄 *Surf Forecast* — %s, %s' % (b.get('name', 'Poleg Beach'),
                                              b.get('sub', 'Netanya'))]
    if days:
        d0 = dt.date.fromisoformat(days[0]['date'])
        d1 = dt.date.fromisoformat(days[-1]['date'])
        lines.append('%s – %s' % (d0.strftime('%b %-d'), d1.strftime('%b %-d')))
        t = days[0]
        lines.append('Today: %s (%d) — %s' % (t['label'], round(t['rating']), t['blurb']))
    if best:
        when = dt.date.fromisoformat(best['date']).strftime('%A')
        lines.append('★ Best: %s — %s (%d)' % (when, best['label'], round(best['rating'])))
    lines.append('Full week + hourly charts attached 📄')
    return '\n'.join(lines)


# --------------------------------------------------------------------- guard
def already_sent_today():
    try:
        return open(LAST_SENT).read().strip() == dt.date.today().isoformat()
    except Exception:
        return False


def mark_sent():
    os.makedirs(STATE, exist_ok=True)
    with open(LAST_SENT, 'w') as f:
        f.write(dt.date.today().isoformat())


# ----------------------------------------------------------------------- main
def main():
    force = '--force' in sys.argv
    pdf_only = '--pdf-only' in sys.argv

    if not pdf_only and not force and already_sent_today():
        print('report already sent today; nothing to do')
        return 0

    snap = surffeed.build_snapshot()
    pdf = build_pdf(snap)
    print('PDF:', pdf)
    if pdf_only:
        return 0

    cfg = surffeed.load_config()
    jid = resolve_group_jid(cfg)
    if not jid:
        print('WhatsApp group "%s" not found in the bridge yet — send it one '
              'message so the bridge learns its id, then rerun.'
              % cfg.get('whatsapp_group', 'Surf Status'), file=sys.stderr)
        return 2

    if not wait_for_bridge():
        print('WhatsApp bridge not reachable on :8080 — will retry next run',
              file=sys.stderr)
        return 3

    ok, msg = send_file(jid, pdf, caption_for(snap))
    if ok:
        mark_sent()
        print('sent to', jid)
        return 0
    print('send failed:', msg, file=sys.stderr)
    return 4


_REPORT_TEMPLATE = r"""<!DOCTYPE html>
