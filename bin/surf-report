<script>
const SNAP=/*__SNAPSHOT__*/;
const RC={Poor:'#e5484d',Fair:'#e0a020',Good:'#12a150',Perfect:'#0aa5c4'};
function rlabel(r){r=Math.round(r);return r>=10?'Perfect':r>=7?'Good':r>=4?'Fair':'Poor';}
function rcolor(r){return RC[rlabel(r)];}
Chart.defaults.animation=false;
Chart.defaults.font.family="'Inter','Segoe UI',sans-serif";

const bands={id:'bands',beforeDraw(c){const{ctx,chartArea,scales}=c;if(!chartArea||!scales.y)return;
