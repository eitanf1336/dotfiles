#!/usr/bin/env python3
"""fatchats - show which open Claude chats have grown fat enough to be worth
/compact-ing, and nag you when one crosses the line.

Every message you send re-bills the whole chat's context, so a 900k-token chat
costs ~10x a 90k one for the same question. The statusline writes a crumb per
live chat into ~/.claude/state/ctx/; this reads them all at once.

Usage:
  fatchats              list live chats, fattest first
  fatchats --notify     desktop-notify once per chat per threshold (timer mode)
  fatchats --all        include stale crumbs (chats that stopped reporting)
  fatchats --json       machine-readable
"""
import json
import os
import subprocess
import sys
import time

CTXDIR = os.path.expanduser("~/.claude/state/ctx")
NOTIFIED = os.path.join(CTXDIR, "notified.json")
STALE_AFTER = 20 * 60          # a crumb older than this = chat is closed or idle
LEVELS = {2: "300k+", 3: "600k+"}

TTY = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
RED, YEL, GRN, DIM, BLD, RST = (
    ("\033[31m", "\033[33m", "\033[32m", "\033[2m", "\033[1m", "\033[0m")
    if TTY else ("", "", "", "", "", ""))


def reap(now):
    """Drop crumbs from chats that are long gone, so the dir stays small."""
    try:
        for fn in os.listdir(CTXDIR):
            if fn.endswith(".json") and fn != "notified.json":
                path = os.path.join(CTXDIR, fn)
                if now - os.path.getmtime(path) > 24 * 3600:
                    os.unlink(path)
    except OSError:
        pass


def crumbs():
    out = []
    now = time.time()
    reap(now)
    try:
        names = os.listdir(CTXDIR)
    except OSError:
        return out
    for fn in names:
        if not fn.endswith(".json") or fn == "notified.json":
            continue
        path = os.path.join(CTXDIR, fn)
        try:
            with open(path) as fh:
                d = json.load(fh)
            d["age"] = now - os.path.getmtime(path)
        except (OSError, ValueError):
            continue
        out.append(d)
    out.sort(key=lambda d: -d.get("tokens", 0))
    return out


def human(tok):
    return f"{tok/1000:.0f}k" if tok >= 1000 else str(tok)


def age_str(sec):
    if sec < 90:
        return "now"
    if sec < 3600:
        return f"{sec/60:.0f}m ago"
    return f"{sec/3600:.0f}h ago"


def notify(title, body):
    for cmd in (["notify-send", "-a", "Claude", "-u", "normal", title, body],):
        try:
            subprocess.run(cmd, check=False, timeout=10)
            return
        except OSError:
            pass


def asleep():
    return os.path.exists(os.path.join(
        os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
        "sleep-mode", "sleeping"))


def do_notify(rows):
    """Nag once per chat per threshold crossed, never twice for the same one.

    Crossings found in the same run are batched into a single popup, so the
    first ever run (which typically finds a pile of already-fat chats) costs
    one notification, not eight.
    """
    try:
        with open(NOTIFIED) as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}
    live = {r["session"] for r in rows}
    state = {k: v for k, v in state.items() if k in live}   # forget closed chats
    new = [r for r in rows
           if r.get("lvl", 0) >= 2 and state.get(r["session"], 0) < r["lvl"]]

    if new and asleep():
        new = []          # stay quiet, and keep the crossing pending for later

    if new:
        for r in new:
            state[r["session"]] = r["lvl"]
        if len(new) == 1:
            r = new[0]
            name = r.get("name") or r["session"][:8]
            word = "getting heavy" if r.get("lvl") == 2 else "very heavy"
            notify(f"Compact: {name}",
                   f"{human(r.get('tokens', 0))} of context, {word}. "
                   f"Every message in it re-bills all of that. Run /compact.")
        else:
            names = ", ".join((r.get("name") or r["session"][:8])[:24]
                              for r in new[:3])
            more = f" +{len(new) - 3} more" if len(new) > 3 else ""
            notify(f"{len(new)} chats need /compact",
                   f"{names}{more}. Together {human(sum(r.get('tokens', 0) for r in new))} "
                   f"of context, re-billed on every message. `fatchats` for the list.")

    os.makedirs(CTXDIR, exist_ok=True)
    with open(NOTIFIED, "w") as fh:
        json.dump(state, fh)


def main():
    args = sys.argv[1:]
    rows = crumbs()
    if "--all" not in args and "--notify" not in args:
        rows = [r for r in rows if r["age"] < STALE_AFTER]
    live = [r for r in rows if r["age"] < STALE_AFTER]

    if "--notify" in args:
        do_notify(live)
        return

    if "--json" in args:
        print(json.dumps(rows, indent=1))
        return

    if not rows:
        print("no live chats reporting (the statusline writes these; "
              "open a chat and it appears)")
        return

    print(f"{BLD}{'chat':38} {'ctx':>7}  {'win':>4}  {'seen':>8}{RST}")
    total = 0
    for r in rows:
        tok = r.get("tokens", 0)
        total += tok
        lvl = r.get("lvl", 0)
        col = RED if lvl >= 3 else YEL if lvl == 2 else DIM if lvl == 0 else ""
        name = (r.get("name") or r["session"][:8])[:38]
        flag = "  /compact" if lvl >= 2 else ""
        print(f"{col}{name:38} {human(tok):>7}  {r.get('pct', 0):>3}%  "
              f"{age_str(r['age']):>8}{flag}{RST}")
    heavy = [r for r in rows if r.get("lvl", 0) >= 2]
    print()
    print(f"{len(rows)} chats, {human(total)} tokens of context in total.")
    if heavy:
        print(f"{RED if TTY else ''}{len(heavy)} worth compacting now"
              f"{RST}: every message you send in one of those re-bills its "
              f"whole context.")
    else:
        print(f"{GRN}nothing worth compacting.{RST}")


if __name__ == "__main__":
    main()
