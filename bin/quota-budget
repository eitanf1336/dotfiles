#!/usr/bin/env python3
"""quota-budget - give a project a hard slice of the weekly Claude quota.

The weekly limit is one number per account, so nothing upstream knows which
project spent what. This tool works it out from the transcripts:

  * every assistant turn in ~/.claude/projects/**/*.jsonl carries its token
    usage, model and cwd. Each turn is priced at API rates (a proxy for how
    hard it hits the quota) and filed under its cwd and the account that was
    live when it was seen. Subagents and headless `claude -p` runs write
    transcripts too, so they count, as long as their cwd is inside the project.
  * every time the account's real weekly % (claude-limits) goes up, that step
    is split across the cwds that spent since the previous step, by cost. So
    parallel Claudes in other projects do not leak into this one's number:
    they take their own share of each step. Spend that has not produced a step
    yet is priced with the learned %-per-$ rate, so a project is stopped
    before the next whole percent shows up.
  * a PreToolUse hook blocks every tool call in a session whose cwd is inside a
    project that is over budget, a UserPromptSubmit hook tells the session its
    budget, and a PostToolUse hook warns at 80/90/95%.

  quota-budget set <name> <pct> [--path DIR]   budget a project (DIR defaults to cwd)
  quota-budget rm <name>
  quota-budget status [name] [--json]          used vs budget (exit 3 if name is over)
  quota-budget top                             spend by cwd this window, budgeted or not
  quota-budget brief <name>                    text to paste into a manager's prompt
  quota-budget tick                            pull + scan new transcript lines (timer, every 60s)
  quota-budget rebuild --since T --base ACCT=PCT   redo the ledger from transcripts since T,
                                               when ACCT's weekly % was PCT
  quota-budget hook                            Claude Code hook entry point (stdin JSON)

Numbers are estimates: they assume quota burns like API price across models,
and any use of the account not on this laptop (claude.ai, the server) gets
blamed on the projects that ran here. Both errors make a project look MORE
expensive, never less, which is the safe side for a budget.
"""
import fcntl
import glob
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
CONF_DIR = os.path.join(HOME, ".config", "quota-budget")
BUDGETS = os.path.join(CONF_DIR, "budgets.json")
STATE_DIR = os.path.join(HOME, ".claude", "quota-budget")
LEDGER = os.path.join(STATE_DIR, "ledger.json")
SEEN = os.path.join(STATE_DIR, "seen.json")
STATUS = os.path.join(STATE_DIR, "status.json")
WARNED = os.path.join(STATE_DIR, "warned")
ACTIVE = os.path.join(HOME, ".claude", "accounts", "active")
# remote/ holds copies of transcripts from other machines: remote/server/ is
# pulled by every tick, remote/server-arena/ is fed by MinecraftArena's
# arena-budget-guard (its bots delete their own transcripts). Their cwds are the
# same paths as on this laptop.
REMOTE = os.path.join(STATE_DIR, "remote")
DEED_PROJECTS = os.path.join(HOME, ".claude-deed", "projects")
HOSTS = os.path.join(CONF_DIR, "hosts.json")   # {host: transcript dir under ~}
PROJECT_ROOTS = [os.path.join(HOME, ".claude", "projects"), DEED_PROJECTS, REMOTE]
WARN_BANDS = (80, 90, 95)
# Eitan's rule for every budgeted Claude: the budget is information, not a
# licence to cut corners. Shown in the brief and on every prompt.
RULES = ("Rules for this budget: (1) you cannot know the cost up front, so work "
         "a bit first; once a real chunk is done (first milestone, or ~10-20% "
         "of the budget), check `quota-budget status {name}`, work out the burn "
         "rate from what that chunk cost, and tell Eitan plainly what the budget "
         "will and will not be enough for (e.g. 'that took 1%, so 5% covers X "
         "and Y but not Z'); re-assess at each milestone or when the plan "
         "changes; (2) if it will not cover the job, "
         "ask him for more, saying how much and why; (3) NEVER cut scope, "
         "quality, checks or steps to save quota without his explicit approval: "
         "when you would have to, stop and ask instead.")
ALLOW_CD = re.compile(r"^\s*cd\s+[^;&|`$()<>\n]+$")
ALLOW_READ = re.compile(r"^\s*quota-budget\s+(status|top|brief)\b[^;&|`$()<>\n]*$")
ALLOW_ADMIN = re.compile(r"^\s*(\S*\/)?quota-budget\s+(set|rm)\b[^;&|`$()<>\n]*$")
STALE_AFTER = 600   # status older than this is reported as stale, never trusted to block

# $ per million tokens: input, output, cache read. Cache writes are priced from
# input (5m = 1.25x, 1h = 2x). Only the ratios matter, the account's real % does
# the scaling.
PRICES = {
    "fable": (10.0, 50.0, 0.25),
    "mythos": (10.0, 50.0, 0.25),
    "opus-5-5": (4.0, 20.0, 0.20),
    "opus": (5.0, 25.0, 0.50),
    "sonnet": (2.0, 10.0, 0.20),
    "haiku": (1.0, 5.0, 0.10),
}


def price_of(model):
    m = (model or "").lower()
    for key in ("fable", "mythos", "opus-5-5", "opus", "sonnet", "haiku"):
        if key in m:
            return PRICES[key]
    return None   # <synthetic> and friends cost nothing


def cost_of(model, u):
    p = price_of(model)
    if not p or not isinstance(u, dict):
        return 0.0
    pin, pout, pread = p
    cc = u.get("cache_creation") or {}
    w1h = cc.get("ephemeral_1h_input_tokens")
    w5m = cc.get("ephemeral_5m_input_tokens")
    if w1h is None and w5m is None:
        w5m, w1h = u.get("cache_creation_input_tokens") or 0, 0
    tokens = ((u.get("input_tokens") or 0) * pin
              + (w5m or 0) * pin * 1.25 + (w1h or 0) * pin * 2.0
              + (u.get("cache_read_input_tokens") or 0) * pread
              + (u.get("output_tokens") or 0) * pout)
    return tokens / 1e6


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def active_account():
    try:
        return open(ACTIVE).read().strip() or "unknown"
    except OSError:
        return "unknown"


def window_epoch(key):
    try:
        return datetime.fromisoformat(key).timestamp()
    except Exception:
        return 0.0


def weekly_reading(account=None):
    """(utilization %, window key, window start epoch) or None. account=None
    reads the live login, a name reads that saved claude-account slot."""
    cmd = ["claude-limits", "--json"] + ([account] if account else [])
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
        d = json.loads(out)
        w = d["seven_day"]
        util = float(w["utilization"])
        reset = datetime.fromisoformat(w["resets_at"])
    except Exception:
        return None
    # resets_at jitters between reads (08:59:59.99 vs 09:00:00.8 seen 4 Oct):
    # round to the nearest hour so the key holds still
    key = (reset + timedelta(minutes=30)).replace(minute=0, second=0, microsecond=0).isoformat()
    start = (reset - timedelta(days=7)).timestamp()
    return util, key, start


def parse_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


# ---------------------------------------------------------------- sources
#
# Every transcript belongs to the Claude account whose quota it burnt:
#   ~/.claude/projects          the login live on this laptop
#   ~/.claude-deed/projects     whatever ~/.claude-deed/.active-account names
#   remote/<host>/...           mirrored from another machine; the account is
#                               in remote/<host>/.account (written on every pull)
# The server runs on the same account as this laptop, so without the mirror
# everything it does looked like use from nowhere (4 Oct: 13 of 15% "unseen").

def account_of(path, live):
    if path.startswith(REMOTE + "/"):
        host = path[len(REMOTE) + 1:].split("/", 1)[0]
        try:
            return open(os.path.join(REMOTE, host, ".account")).read().strip() or live
        except OSError:
            return live
    if path.startswith(DEED_PROJECTS + "/"):
        try:
            return open(os.path.join(HOME, ".claude-deed", ".active-account")).read().strip() or "deed"
        except OSError:
            return "deed"
    return live


def pull_remote(ledger, since):
    """Mirror the other machines' new transcript lines into remote/<host>/.
    Transcripts are append-only, so rsync of the recently touched files is
    cheap. A host that does not answer is skipped, never fatal."""
    hosts = load(HOSTS, {"server": ".claude/projects"})
    pulled = ledger.setdefault("pulled", {})
    ssh = "ssh -o BatchMode=yes -o ConnectTimeout=10 -o ControlPath=none"
    for host, rdir in hosts.items():
        started = time.time()
        last = pulled.get(host, since)
        mins = int((started - last) / 60) + 5
        dest = os.path.join(REMOTE, host, "projects")
        try:
            r = subprocess.run(
                ssh.split() + [host, f"cat ~/.claude/accounts/active 2>/dev/null; echo; "
                               f"cd ~/{rdir} && find . -name '*.jsonl' -mmin -{mins}"],
                capture_output=True, text=True, timeout=60)
            if r.returncode != 0:
                raise RuntimeError(r.stderr.strip()[:200])
            lines = r.stdout.split("\n")
            account, files = lines[0].strip(), [l for l in lines[1:] if l.strip()]
            os.makedirs(dest, exist_ok=True)
            if account:
                with open(os.path.join(REMOTE, host, ".account"), "w") as f:
                    f.write(account)
            if files:
                r = subprocess.run(
                    ["rsync", "-a", "-e", ssh, "--files-from=-",
                     f"{host}:{rdir}/", dest + "/"],
                    input="\n".join(files), capture_output=True, text=True, timeout=600)
                if r.returncode not in (0, 23, 24):   # 23/24 = a file vanished mid-copy (the arena CLI deletes its own)
                    raise RuntimeError(r.stderr.strip()[:200])
            pulled[host] = started
        except Exception as e:
            print(f"quota-budget: pull from {host} failed: {e}", file=sys.stderr)


# ---------------------------------------------------------------- tick
#
# Attribution is by deltas: new spend piles up as "pending" $ per (start dir,
# cwd) on the account that paid for it; when that account's weekly % rises by
# D, D is split across its pending pile by cost and the pile is cleared. k
# (% per $) is the ratio over the recent steps and prices the pile that has not
# been converted yet, so a project is stopped before the next whole percent
# shows up, not after.

def new_account(key, util):
    return {"window": key, "util": util, "assigned": {}, "pending": {},
            "k": None, "samples": []}


def session_root(path, files=None):
    """The cwd a session started in. A session's cwd follows `cd`, so this is
    what ties a manager to its project even after it wanders off. Subagent
    transcripts belong to the session that spawned them."""
    if not path:
        return None
    m = re.match(r"(.*)/([^/]+)/subagents/[^/]+\.jsonl$", path or "")
    if m:
        path = f"{m.group(1)}/{m.group(2)}.jsonl"
    fs = (files or {}).get(path)
    if fs and fs.get("root"):
        return fs["root"]
    try:
        with open(path, "rb") as f:
            head = f.read(1 << 20)
    except OSError:
        return None
    m = re.search(rb'"cwd"\s*:\s*"((?:[^"\\]|\\.)*)"', head)
    root = json.loads(b'"' + m.group(1) + b'"') if m else None
    if root and fs is not None:
        fs["root"] = root
    return root


def apply_reading(a, reading, now):
    util, key, _ = reading
    if (abs(window_epoch(key) - window_epoch(a["window"])) > 12 * 3600
            or util < a["util"] - 1.5):
        # a real new week (the reset moves by days, or the % fell): what was
        # assigned belongs to the old week. Pending spend is kept, it is
        # mostly from after the reset.
        a["window"], a["assigned"], a["util"] = key, {}, 0.0
    a["window"] = key
    step = util - a["util"]
    if step > 0:
        pend = sum(a["pending"].values())
        if pend > 0:
            for k_, c in a["pending"].items():
                a["assigned"][k_] = a["assigned"].get(k_, 0.0) + step * c / pend
            a.setdefault("samples", []).append([step, pend])
            a["samples"] = a["samples"][-40:]
            tot_step = sum(x[0] for x in a["samples"])
            tot_pend = sum(x[1] for x in a["samples"])
            # one step on a thin pile says little; wait for a few dollars of evidence
            if tot_pend >= 5.0:
                a["k"] = tot_step / tot_pend
            a["pending"] = {}
        else:
            a["assigned"]["(unseen: claude.ai, phone, other machines)"] = \
                a["assigned"].get("(unseen: claude.ai, phone, other machines)", 0.0) + step
        a["util"] = util
    a["read_at"] = now


def tick(rebuild=None):
    """rebuild = (since epoch, {account: % at that moment}) starts the ledger
    over from transcripts; normal ticks pass None."""
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(os.path.join(STATE_DIR, "tick.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)    # two ticks at once would count twice
    if rebuild:
        for f in (LEDGER, SEEN):
            if os.path.exists(f):
                os.remove(f)
    ledger = load(LEDGER, {"files": {}, "accounts": {}, "last_scan": 0})
    seen = load(SEEN, {})
    live = active_account()
    accts = ledger["accounts"]
    first_run = not ledger["files"]
    now = time.time()
    live_reading = weekly_reading()
    if first_run and not live_reading:
        print("quota-budget: no usage reading, try again", file=sys.stderr)
        return 1
    # first run: this window's history (or the rebuild point); then fresh lines only
    if rebuild:
        floor = rebuild[0]
    elif first_run:
        floor = live_reading[2]
    else:
        floor = now - 86400
    pull_remote(ledger, floor if first_run else now - 3600)

    files = []
    for root in PROJECT_ROOTS:
        files += glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True)
    since = ledger["last_scan"] - 120
    for path in files:
        try:
            st = os.stat(path)
        except OSError:
            continue
        fs = ledger["files"].get(path)
        if fs is None:
            if st.st_mtime < floor or (not first_run and st.st_mtime < since
                                       and not path.startswith(REMOTE + "/")):
                ledger["files"][path] = {"off": st.st_size}
                continue
            fs = ledger["files"][path] = {"off": 0}
        if st.st_size < fs["off"]:
            fs["off"] = 0          # rewritten
        if st.st_size == fs["off"]:
            continue
        with open(path, "rb") as f:
            f.seek(fs["off"])
            data = f.read()
        end = data.rfind(b"\n") + 1   # never consume a half-written line
        fs["off"] += end
        root = session_root(path, ledger["files"])
        acct = account_of(path, live)
        for raw in data[:end].splitlines():
            if b'"usage"' not in raw or b'"assistant"' not in raw:
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            if d.get("cwd"):
                fs["cwd"] = d["cwd"]
            msg = d.get("message") or {}
            # one request is logged once per content block, and resumed or
            # forked sessions copy old turns into a new file: count each once
            rid = d.get("requestId") or msg.get("id")
            if not rid or rid in seen:
                continue
            ts = parse_ts(d.get("timestamp", ""))
            seen[rid] = ts
            if ts < floor:
                continue
            c = cost_of(msg.get("model"), msg.get("usage"))
            if c > 0:
                cwd = d.get("cwd") or fs.get("cwd") or "?"
                key = (root or cwd) + "\t" + cwd
                if acct not in accts:
                    accts[acct] = new_account("", 0.0)
                p = accts[acct]["pending"]
                p[key] = p.get(key, 0.0) + c

    # read every account that has spend waiting, plus the live one
    for name, a in accts.items():
        if name == live:
            reading = live_reading
        elif a["pending"]:
            reading = weekly_reading(name)
        else:
            continue
        if not reading:
            continue
        if not a["window"]:                 # first sight of this account
            a["window"] = reading[1]
            if rebuild:
                a["util"] = rebuild[1].get(name, 0.0)
            elif first_run:
                a["util"] = 0.0             # history converts below
            else:
                a["util"] = reading[0]      # nothing known about the past
        apply_reading(a, reading, now)
        if first_run and not rebuild:
            a["pending"] = {}               # history the current % does not cover
    if live not in accts and live_reading:
        accts[live] = new_account(live_reading[1], live_reading[0])
    seen = {k: v for k, v in seen.items() if v >= now - 8 * 86400}
    # the mirror only needs this week; rsync keeps the server's mtimes
    for path in list(ledger["files"]):
        if path.startswith(os.path.join(REMOTE, "") ) and "/projects/" in path:
            try:
                if os.path.getmtime(path) < now - 9 * 86400:
                    os.remove(path)
                    del ledger["files"][path]
            except OSError:
                ledger["files"].pop(path, None)
    ledger["last_scan"] = now
    save(LEDGER, ledger)
    save(SEEN, seen)
    save(STATUS, compute_status(ledger))
    return 0


# ---------------------------------------------------------------- math

def inside(cwd, root):
    root = root.rstrip("/")
    return cwd == root or cwd.startswith(root + "/")


def counts_for(key, path):
    """Spend is keyed "<session start dir>\t<cwd at the time>"; it belongs to
    a project if either is inside it."""
    return any(inside(part, path) for part in key.split("\t"))


def usage_by_cwd(ledger):
    """{key: (weekly %, $ not yet converted)} summed over accounts."""
    agg = {}
    # an account that has not stepped yet borrows the rate learned on another
    known = [a["k"] for a in ledger["accounts"].values() if a.get("k")]
    fallback = max(known) if known else 0.0
    for a in ledger["accounts"].values():
        k = a.get("k") or fallback
        for cwd in set(a["assigned"]) | set(a["pending"]):
            pend = a["pending"].get(cwd, 0.0)
            u, p = agg.get(cwd, (0.0, 0.0))
            agg[cwd] = (u + a["assigned"].get(cwd, 0.0) + pend * k, p + pend)
    return agg


def compute_status(ledger):
    budgets = load(BUDGETS, {})
    agg = usage_by_cwd(ledger)
    out = {"at": time.time(), "projects": {}, "accounts": {}}
    for name, a in ledger["accounts"].items():
        out["accounts"][name] = {"util": a["util"], "window": a["window"],
                                 "k": a.get("k")}
    for pname, b in budgets.items():
        used = sum(u for key, (u, _) in agg.items() if counts_for(key, b["path"]))
        limit = float(b["weekly_pct"])
        out["projects"][pname] = {
            "path": b["path"], "limit": limit, "used": round(used, 3),
            "over": used >= limit, "left": round(max(0.0, limit - used), 3)}
    return out


def fresh_status():
    st = load(STATUS, None)
    if not st:
        return None
    st["stale"] = time.time() - st.get("at", 0) > STALE_AFTER
    return st


def project_for(cwd, st):
    """The most specific budgeted project containing cwd."""
    best = None
    for name, p in (st or {}).get("projects", {}).items():
        if inside(cwd or "", p["path"]):
            if not best or len(p["path"]) > len(st["projects"][best]["path"]):
                best = name
    return best


# ---------------------------------------------------------------- hook

def hook():
    try:
        inp = json.load(sys.stdin)
    except ValueError:
        return 0
    st = fresh_status()
    names = {project_for(inp.get("cwd"), st),
             project_for(session_root(inp.get("transcript_path")), st)} - {None}
    if not names:
        return 0
    # the session answers to every project it is tied to; report the tightest
    name = max(names, key=lambda n: (st["projects"][n]["over"],
                                     st["projects"][n]["used"] / max(st["projects"][n]["limit"], 1e-9)))
    p = st["projects"][name]
    event = inp.get("hook_event_name")
    line = (f"Quota budget for project '{name}': {p['used']:.2f}% of "
            f"{p['limit']:g}% weekly used ({p['left']:.2f}% left)"
            + (" [reading is stale]" if st["stale"] else "") + ".")

    if event == "PreToolUse":
        cmd = (inp.get("tool_input") or {}).get("command", "") \
            if inp.get("tool_name") == "Bash" else ""
        # still allowed when over: leaving the folder (only frees a session that
        # wandered in; one that started inside stays tied to it) and reading
        # the budget
        # his call (4 Oct 2026): Claude may also change or remove a budget itself
        if cmd and (ALLOW_CD.match(cmd) or ALLOW_READ.match(cmd) or ALLOW_ADMIN.match(cmd)):
            return 0
        if p["over"] and not st["stale"]:
            print(f"BLOCKED: project '{name}' has used its whole quota budget "
                  f"({p['used']:.2f}% of {p['limit']:g}% weekly). Stop working "
                  "and end the turn with: where things stand, what is still "
                  "left to do, and your estimate of how much more budget that "
                  "needs, as a request to Eitan. Do not drop or shrink the "
                  "remaining work on your own. Eitan lets Claude raise or remove it too "
                  f"(quota-budget set {name} <pct>). If this session only "
                  "wandered into the folder, a bare `cd <elsewhere>` still works.",
                  file=sys.stderr)
            return 2
        return 0

    if event == "UserPromptSubmit" or event == "SessionStart":
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": line + " When it runs out every tool call is "
            "blocked. " + RULES.format(name=name)}}))
        return 0

    if event == "PostToolUse":
        if p["limit"] <= 0:
            return 0
        band = max([b for b in WARN_BANDS if p["used"] >= p["limit"] * b / 100], default=0)
        if not band:
            return 0
        sid = inp.get("session_id", "x")
        mark = os.path.join(WARNED, f"{name}.{sid}")
        try:
            prev = int(open(mark).read())
        except (OSError, ValueError):
            prev = 0
        if band <= prev:
            return 0
        os.makedirs(WARNED, exist_ok=True)
        with open(mark, "w") as f:
            f.write(str(band))
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "additionalContext": f"WARNING: {band}% of the budget is gone. " + line
            + " Do NOT cut scope or quality to stretch it. Tell Eitan now what "
            "the rest of the budget will cover, what it will not, and ask whether "
            "he wants to raise it; at 100% every tool call is blocked."}}))
    return 0


# ---------------------------------------------------------------- cli

def fmt_status(st, only=None):
    rows = []
    if st.get("stale"):
        rows.append(f"(reading is {int(time.time() - st['at'])}s old: is quota-budget.timer running?)")
    for name, p in sorted(st["projects"].items()):
        if only and name != only:
            continue
        frac = p["used"] / p["limit"] if p["limit"] else 1
        bar = "#" * min(20, int(frac * 20)) + "." * max(0, 20 - int(frac * 20))
        tag = "OVER" if p["over"] else f"{p['left']:.2f}% left"
        rows.append(f"{name:<18} [{bar}] {p['used']:6.2f}% / {p['limit']:g}%  {tag}   {p['path']}")
    for name, a in st["accounts"].items():
        k = f", ~{a['k'] * 10:.2f}% per $10 of API-priced use" if a.get("k") else ", rate not learned yet"
        rows.append(f"  account {name}: weekly {a['util']:g}%{k}, window resets {a['window'][:16]}")
    return "\n".join(rows) or "no budgets set (quota-budget set <name> <pct>)"


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    args = argv[2:]
    if cmd == "tick":
        return tick()
    if cmd == "rebuild":
        # quota-budget rebuild --since 2026-10-04T00:46 --base eitan=1
        if "--since" not in args:
            print("usage: quota-budget rebuild --since <local ISO time> [--base <account>=<weekly % then> ...]")
            return 1
        since = datetime.fromisoformat(args[args.index("--since") + 1]).timestamp()
        base = {}
        for i, x in enumerate(args):
            if x == "--base":
                n, _, v = args[i + 1].partition("=")
                base[n] = float(v)
        return tick(rebuild=(since, base))
    if cmd == "hook":
        try:
            return hook()
        except Exception as e:      # a bug here must never break a session
            print(f"quota-budget hook error: {e}", file=sys.stderr)
            return 0
    if cmd == "set":
        if len(args) < 2:
            print("usage: quota-budget set <name> <pct> [--path DIR]")
            return 1
        path = os.getcwd()
        if "--path" in args:
            path = args[args.index("--path") + 1]
        budgets = load(BUDGETS, {})
        budgets[args[0]] = {"path": os.path.realpath(os.path.expanduser(path)),
                            "weekly_pct": float(args[1])}
        save(BUDGETS, budgets)
        ledger = load(LEDGER, None)
        if ledger:
            save(STATUS, compute_status(ledger))
        print(f"{args[0]}: {float(args[1]):g}% weekly for {budgets[args[0]]['path']}")
        return 0
    if cmd == "rm":
        budgets = load(BUDGETS, {})
        budgets.pop(args[0] if args else "", None)
        save(BUDGETS, budgets)
        ledger = load(LEDGER, None)
        if ledger:
            save(STATUS, compute_status(ledger))
        return 0
    st = fresh_status()
    if not st:
        print("no data yet: run `quota-budget tick` (first run scans this week's transcripts)")
        return 1
    if cmd == "status":
        only = next((a for a in args if not a.startswith("-")), None)
        if "--json" in args:
            print(json.dumps(st["projects"].get(only) if only else st, indent=1))
        else:
            print(fmt_status(st, only))
        return 3 if only and st["projects"].get(only, {}).get("over") else 0
    if cmd == "top":
        agg = usage_by_cwd(load(LEDGER, {"accounts": {}}))
        for key, (u, p) in sorted(agg.items(), key=lambda x: -x[1][0])[:25]:
            root, _, cwd = key.partition("\t")
            where = (cwd or root) if root == cwd or not cwd else f"{cwd}  (started in {root})"
            print(f"{u:6.2f}%  (${p:7.2f} pending)  {where}")
        return 0
    if cmd == "brief":
        name = args[0] if args else None
        p = st["projects"].get(name)
        if not p:
            print(f"no budget named {name!r}")
            return 1
        print(f"""You manage project '{name}' ({p['path']}) on a hard quota budget of {p['limit']:g}% of the weekly Claude limit. {p['used']:.2f}% is already spent this week.
- Everything started inside {p['path']} counts, wherever it later cd's to: you, your subagents, any `claude -p` you launch. Launch all of it from inside that directory.
- Check what is left with `quota-budget status {name}` before every expensive step (a big agent, a long loop). It updates every minute.
- Do not waste it (Sonnet/Haiku for mechanical work, short briefs, no fan-outs, no polling), but waste is the only thing you cut on your own.
- You cannot know the cost up front, so work a bit first. Once a real chunk is done (first milestone, or ~10-20% of the budget), measure what it cost and tell Eitan what the budget will be enough for and what it will not, as a concrete estimate ("that took 1%, so 5% covers X and Y but not Z"). Re-assess at each milestone or when the plan changes.
- If it will not cover the job, ask him for more (how much, and for what). NEVER cut scope, quality, checks or steps because of quota without his explicit approval. If you would have to, stop and ask.
- At 80/90/95% you get a warning: re-assess and ask him then. At 100% every tool call in the project is blocked by a hook and you cannot get around it, so ask before you get there.""")
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
