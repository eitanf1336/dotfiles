#!/usr/bin/env bash
# LastPass web vault as a standalone desktop app (Chrome --app mode), detached
# from the terminal so closing the terminal does not take it down with it.
#
# Uses a DEDICATED Chrome profile (--user-data-dir) rather than the default one.
# That's what guarantees a real standalone window with its own dock icon: with
# the default profile, when Chrome is already running the new --app window is
# absorbed by the running browser and gets grouped under the Chrome icon (and
# --class is ignored). A separate profile forces its own instance + app_id.
#
# This is the web vault, not the browser extension: it is where you read and
# edit entries. Autofill in normal browsing still comes from the extension in
# your main Chrome profile. Log in once here; the session persists.
URL="https://lastpass.com/vault/"
PROFILE="$HOME/.local/share/lastpass-app"
setsid -f /usr/bin/google-chrome \
  --app="$URL" \
  --user-data-dir="$PROFILE" \
  --class=LastPass \
  --name=LastPass \
  "$@" \
  >/dev/null 2>&1
