#!/usr/bin/env python3
"""Take one monitor's light down to nothing, and put it back.

Painting a screen black leaves the backlight at full, so the panel still glows
dark grey. This turns the light itself down, per monitor:

  * a laptop panel  -> logind SetBrightness on its backlight device (no root)
  * a DDC/CI monitor -> ddcutil VCP 0x10
  * a DisplayLink screen -> nothing; it answers no DDC and has no backlight the
    machine can reach, so black pixels are its floor.

Usage:
  screen-dark --at X,Y on|off     the monitor whose logical origin is X,Y
  screen-dark <connector> on|off  e.g. HDMI-1, eDP-1
  screen-dark restore-all         put every monitor this tool dimmed back
  screen-dark status
"""
import fcntl
import json
import os
import subprocess
import sys

CACHE = os.path.expanduser("~/.cache/screen-dark")
BUSES = os.path.join(CACHE, "buses.json")
BACKLIGHT_DIR = "/sys/class/backlight"
DDC_TIMEOUT = 20
TARGET = os.path.join(CACHE, "target")
WORKER = os.path.join(CACHE, "worker.lock")


def run(cmd, timeout=DDC_TIMEOUT):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return 1, "", "unavailable"


# --- monitor identity -------------------------------------------------------

def logical_monitors():
    """[(x, y, connector)] straight from Mutter, so an index never has to be
    guessed: the caller hands us a position and we name the output."""
    rc, out, _ = run(["gdbus", "call", "-e", "-d", "org.gnome.Mutter.DisplayConfig",
                      "-o", "/org/gnome/Mutter/DisplayConfig",
                      "-m", "org.gnome.Mutter.DisplayConfig.GetCurrentState"], 15)
    if rc != 0:
        return []
    import re
    # logical monitors: (x, y, scale, transform, primary, [(connector, ...)], ...)
    found = []
    # gdbus prints "uint32" only on the first tuple of the list, so it is optional.
    for m in re.finditer(r"\((-?\d+),\s*(-?\d+),\s*[\d.]+,\s*(?:uint32 )?\d+,\s*"
                         r"(?:true|false),\s*\[\('([A-Za-z0-9-]+)'", out):
        found.append((int(m.group(1)), int(m.group(2)), m.group(3)))
    return found


def connector_at(x, y):
    for mx, my, conn in logical_monitors():
        if mx == x and my == y:
            return conn
    return None


# --- the two ways to take the light down ------------------------------------

def backlight_device(connector):
    """A laptop panel's backlight. Only eDP/LVDS panels have one."""
    if not connector.startswith(("eDP", "LVDS", "DSI")):
        return None
    try:
        devs = os.listdir(BACKLIGHT_DIR)
    except OSError:
        return None
    return devs[0] if devs else None


def ddc_bus(connector):
    """The i2c bus of a DDC/CI monitor, cached: a full detect costs seconds."""
    cache = {}
    if os.path.exists(BUSES):
        try:
            cache = json.load(open(BUSES))
        except Exception:
            cache = {}
    if connector in cache:
        return cache[connector]

    # A miss must be recorded too. A DisplayLink screen answers no DDC, and
    # without a negative entry every brightness keypress would pay for a fresh
    # detect looking for an answer that never comes.
    rc, out, _ = run(["ddcutil", "detect", "--brief"], 90)
    if rc != 0:
        return None
    for _x, _y, conn in logical_monitors():
        cache.setdefault(conn, None)
    bus = cur = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("I2C bus:"):
            cur = line.split("/dev/i2c-")[-1].strip()
        elif line.startswith("DRM connector:") and cur:
            # card2-HDMI-A-1 -> HDMI-1, matching Mutter's connector names
            name = line.split(":", 1)[1].strip()
            name = name.split("-", 1)[1] if "-" in name else name
            name = name.replace("HDMI-A-", "HDMI-").replace("DP-", "DP-")
            cache[name] = cur
            cur = None
    for _x, _y, conn in logical_monitors():
        cache.setdefault(conn, None)
    os.makedirs(CACHE, exist_ok=True)
    json.dump(cache, open(BUSES, "w"), indent=2)
    return cache.get(connector)


def statefile(connector):
    return os.path.join(CACHE, "%s.json" % connector.replace("/", "_"))


def dark_on(connector):
    dev = backlight_device(connector)
    if dev:
        path = os.path.join(BACKLIGHT_DIR, dev, "brightness")
        try:
            prior = int(open(path).read().strip())
        except OSError:
            return "no backlight"
        if prior == 0:
            return "already dark"
        save(connector, {"kind": "backlight", "device": dev, "prior": prior})
        set_backlight(dev, 0)
        return "backlight %s: %d -> 0" % (dev, prior)

    bus = ddc_bus(connector)
    if bus:
        rc, out, _ = run(["ddcutil", "--bus", bus, "getvcp", "10"])
        if rc != 0:
            return "ddc unreachable"
        prior = None
        for tok in out.split():
            if tok.rstrip(",").isdigit() and "current value" in out:
                pass
        import re
        m = re.search(r"current value\s*=\s*(\d+)", out)
        if m:
            prior = int(m.group(1))
        if prior is None:
            return "ddc gave no level"
        save(connector, {"kind": "ddc", "bus": bus, "prior": prior})
        run(["ddcutil", "--bus", bus, "setvcp", "10", "0"])
        return "ddc bus %s: %d -> 0" % (bus, prior)

    return "no light control (DisplayLink or unknown); black pixels only"


def dark_off(connector):
    st = load(connector)
    if not st:
        return "was not dimmed"
    if st["kind"] == "backlight":
        set_backlight(st["device"], st["prior"])
    else:
        run(["ddcutil", "--bus", st["bus"], "setvcp", "10", str(st["prior"])])
    try:
        os.remove(statefile(connector))
    except OSError:
        pass
    return "restored to %d" % st["prior"]


def set_backlight(device, value):
    sid = subprocess.run(["loginctl", "show-session", "self", "-p", "Id", "--value"],
                         capture_output=True, text=True).stdout.strip()
    if not sid:
        sid = subprocess.run(["bash", "-c",
                              "loginctl | awk '/%s/{print $1; exit}'" % os.environ.get("USER", "")],
                             capture_output=True, text=True).stdout.strip()
    run(["busctl", "call", "org.freedesktop.login1",
         "/org/freedesktop/login1/session/%s" % sid,
         "org.freedesktop.login1.Session", "SetBrightness", "ssu",
         "backlight", device, str(value)], 10)


def save(connector, data):
    os.makedirs(CACHE, exist_ok=True)
    json.dump(data, open(statefile(connector), "w"))


def load(connector):
    try:
        return json.load(open(statefile(connector)))
    except Exception:
        return None


def restore_all():
    if not os.path.isdir(CACHE):
        return "nothing to restore"
    done = []
    for f in os.listdir(CACHE):
        if f.endswith(".json") and f != "buses.json":
            done.append("%s: %s" % (f[:-5], dark_off(f[:-5])))
    return "\n".join(done) if done else "nothing was dimmed"


def lock():
    """One brightness change at a time. Super+B pressed twice quickly would
    otherwise put two ddcutil conversations on the same i2c bus at once, and
    the monitor answers neither of them properly."""
    os.makedirs(CACHE, exist_ok=True)
    fh = open(os.path.join(CACHE, "lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
    except OSError:
        pass
    return fh


# --- absolute level, for the brightness keys and the sunrise ramp -----------

def hardware_monitors():
    """[(connector, x, y)] for every screen whose real light this machine can
    drive. A DisplayLink screen is absent from this list, which is what tells
    the overlay it still has to dim that one in software."""
    out = []
    for x, y, conn in logical_monitors():
        if backlight_device(conn) or ddc_bus(conn):
            out.append((conn, x, y))
    return out


def apply_level(connector, pct):
    pct = max(0, min(100, int(pct)))
    # A screen blacked out by Super+B stays black: move the level it will be
    # restored to instead of fighting the blackout.
    st = load(connector)
    if st:
        dev_max = 100
        if st["kind"] == "backlight":
            dev_max = read_max(st["device"])
        st["prior"] = int(round(dev_max * pct / 100.0))
        save(connector, st)
        return None

    dev = backlight_device(connector)
    if dev:
        set_backlight(dev, int(round(read_max(dev) * pct / 100.0)))
        return None
    bus = ddc_bus(connector)
    if bus:
        rc, _out, err = run(["ddcutil", "--bus", bus, "setvcp", "10", str(pct)])
        if rc != 0:
            # A write that did not land must not be reported as one that did.
            return "FAILED (%s)" % (err.strip().splitlines()[-1] if err.strip() else "rc %d" % rc)
    return None


def read_max(device):
    try:
        return int(open(os.path.join(BACKLIGHT_DIR, device, "max_brightness")).read().strip()) or 100
    except OSError:
        return 100


def level(pct):
    """Set every hardware-capable screen to pct.

    Coalescing matters: holding Super+minus queues a keypress every few tens of
    milliseconds while one DDC conversation takes a second or two. So the target
    is written down and only one worker runs; later presses just move the target
    and exit, and the worker picks up the newest value when it comes round. The
    screen follows the last press instead of crawling through every one."""
    os.makedirs(CACHE, exist_ok=True)
    with open(TARGET, "w") as fh:
        fh.write(str(int(pct)))

    fh = open(WORKER, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return "queued (a worker already has it)"

    applied = None
    done = []
    while True:
        try:
            target = int(open(TARGET).read().strip())
        except Exception:
            break
        if target == applied:
            break
        applied = target
        done = []
        for conn, _x, _y in hardware_monitors():
            problem = apply_level(conn, target)
            done.append(conn if not problem else "%s %s" % (conn, problem))
    return "set %s to %s%%" % (", ".join(done) or "nothing", applied)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    if args[0] == "restore-all":
        _l = lock()
        print(restore_all()); return 0
    if args[0] == "level":
        if len(args) < 2:
            print("usage: screen-dark level <0-100>", file=sys.stderr); return 1
        print(level(args[1])); return 0
    if args[0] == "positions":
        # what the dimming overlay must skip, since these screens dim for real
        print(" ".join("%d,%d" % (x, y) for _c, x, y in hardware_monitors())); return 0
    if args[0] == "status":
        for m in logical_monitors():
            st = load(m[2])
            print("%-10s at %d,%d  %s" % (m[2], m[0], m[1],
                  "DIMMED (was %s)" % st["prior"] if st else "normal"))
        return 0

    if args[0] == "--at":
        if len(args) < 3:
            print("usage: screen-dark --at X,Y on|off", file=sys.stderr); return 1
        try:
            x, y = (int(v) for v in args[1].split(","))
        except ValueError:
            print("bad position", file=sys.stderr); return 1
        connector = connector_at(x, y)
        action = args[2]
        if not connector:
            print("no monitor at %d,%d" % (x, y), file=sys.stderr); return 1
    else:
        connector, action = args[0], (args[1] if len(args) > 1 else "on")

    _l = lock()
    print("%s: %s" % (connector, dark_on(connector) if action == "on" else dark_off(connector)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
