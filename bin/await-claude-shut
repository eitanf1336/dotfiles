#!/usr/bin/env bash
# await-claude-shut — wait until no Claude agent/chat is actively running,
# then power off (or suspend) the PC. "Actively running" = a background agent
# is working or a chat is mid-reply (claude-status exit code 1). Idle chats
# and paused agents waiting for input do NOT count as running.
#
# Kick off your agents, run this, walk away.
#
#   await-claude-shut [options]
#     -i, --interval S   seconds between checks while Claude is busy (default 30)
#     -c, --confirm S    seconds between the confirming checks       (default 3)
#     -s, --stable N     consecutive clear checks required           (default 2)
#     -g, --grace S      cancellable countdown before shutdown       (default 60)
#     -a, --action A     poweroff | reboot | suspend | halt          (default poweroff)
#     -n, --dry-run      print what it would do; never shut down
#         --cancel       kill a waiter started earlier (any window), then exit
#         --status       say whether a waiter is armed, then exit
#     -h, --help
#
# During the grace countdown, press Ctrl+C to cancel. If Claude starts
# working again mid-countdown, the shutdown auto-aborts and it resumes waiting.
#
# A suspend that bounces straight back out (the machine sleeps for a couple of
# seconds and then wakes itself) is retried rather than reported as success;
# $AWAIT_CLAUDE_SHUT_TRIES (3) and $AWAIT_CLAUDE_SHUT_BOUNCE (20 seconds) tune
# how many attempts, and how short a nap counts as a bounce.
#
# Everything it does is also appended to ~/.local/state/await-claude-shut.log,
# so a run that ended in a closed window can still be diagnosed afterwards.
set -uo pipefail

INTERVAL=30
CONFIRM=3
STABLE=2
GRACE=60
ACTION=poweroff
DRYRUN=0
STATUS_CMD=${CLAUDE_STATUS_CMD:-claude-status}   # overridable for testing
LOG=${AWAIT_CLAUDE_SHUT_LOG:-$HOME/.local/state/await-claude-shut.log}
RUNDIR=${AWAIT_CLAUDE_SHUT_RUNDIR:-${XDG_RUNTIME_DIR:-/tmp}/claude-shut}
PIDFILE=$RUNDIR/waiter.pid

die() { echo "await-claude-shut: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    -i|--interval) INTERVAL=${2:?}; shift 2;;
    -c|--confirm)  CONFIRM=${2:?};  shift 2;;
    -s|--stable)   STABLE=${2:?};   shift 2;;
    -g|--grace)    GRACE=${2:?};    shift 2;;
    -a|--action)   ACTION=${2:?};   shift 2;;
    -n|--dry-run)  DRYRUN=1; shift;;
    --cancel)      MODE=cancel; shift;;
    --status)      MODE=status; shift;;
    -h|--help)     sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) die "unknown option: $1 (try --help)";;
  esac
done
MODE=${MODE:-run}

case "$ACTION" in
  poweroff|reboot|suspend|halt) ;;
  *) die "invalid --action '$ACTION' (poweroff|reboot|suspend|halt)";;
esac

mkdir -p "$(dirname "$LOG")" 2>/dev/null || LOG=/dev/null
mkdir -p "$RUNDIR" 2>/dev/null

# Print to the window AND to the log, so closing the window doesn't erase the
# evidence of what happened.
say() {
  printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null
}
wipe() { printf '\r%*s\r' 64 ''; }   # clear the countdown line

# A shutdown that quietly refused is the one failure mode that looks exactly
# like success from a closed terminal window, so shout about it on the desktop.
notify() {
  [ "${AWAIT_CLAUDE_SHUT_NOTIFY:-1}" = 0 ] && return 0
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -u critical -i system-shutdown "$1" "$2" >/dev/null 2>&1
}

# The pid of a waiter that is still alive, or nothing.
live_waiter() {
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [ -n "${pid:-}" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

case "$MODE" in
  status)
    if pid=$(live_waiter); then echo "armed (pid $pid)"; exit 0; fi
    echo "not armed"; exit 1;;
  cancel)
    if pid=$(live_waiter); then
      say "cancelled by --cancel (killing waiter pid $pid)"
      for sig in INT TERM KILL; do
        kill -"$sig" "$pid" 2>/dev/null
        for _ in 1 2 3 4 5 6; do
          kill -0 "$pid" 2>/dev/null || break 2
          sleep 0.5
        done
      done
      kill -0 "$pid" 2>/dev/null && { echo "could not kill waiter pid $pid"; exit 1; }
      rm -f "$PIDFILE" 2>/dev/null
      echo "cancelled the waiter (pid $pid)"
      exit 0
    fi
    echo "nothing to cancel: no waiter is armed"; exit 1;;
esac

command -v "$STATUS_CMD" >/dev/null 2>&1 || die "'$STATUS_CMD' not found on PATH"

# One waiter at a time: a second armed countdown just races the first.
if pid=$(live_waiter); then
  say "another waiter is already armed (pid $pid); not starting a second one."
  notify "Claude shutdown already armed" \
          "A waiter is already counting down (pid $pid). Cancel it first: await-claude-shut --cancel"
  exit 3
fi
echo $$ >"$PIDFILE" 2>/dev/null
trap 'rm -f "$PIDFILE" 2>/dev/null' EXIT

# bash only runs a trap once the *foreground* command finishes, so a plain
# `sleep 30` would swallow a Ctrl+C (or a --cancel) for up to half a minute.
# Sleeping in the background and `wait`-ing on it makes every wait interruptible.
NAP_PID=
nap() { sleep "$1" & NAP_PID=$!; wait "$NAP_PID" 2>/dev/null; NAP_PID=; }
on_cancel() {
  [ -n "$NAP_PID" ] && kill "$NAP_PID" 2>/dev/null
  wipe; say "cancelled."; rm -f "$PIDFILE" 2>/dev/null; exit 130
}
trap on_cancel INT TERM

# Return 0 if Claude is actively running (compute in flight), 1 otherwise.
# NOTE: one call costs a couple of seconds (it queries the agent daemon and
# samples TUI CPU), which is why every wait below is wall-clock based.
claude_busy() {
  "$STATUS_CMD" -q >/dev/null 2>&1
  [ "$?" -eq 1 ]
}

# logind refuses poweroff/reboot outright while anything holds a *block*
# inhibitor on "shutdown" (GNOME 50 holds one on its own behalf whenever an app
# inhibits logout), and would refuse a suspend the same way for "sleep". Log who
# is holding what before we try, so a refusal is self-explanatory in the log.
inhibitor_what() { case "$1" in suspend) echo sleep;; *) echo shutdown;; esac; }
log_blockers() {
  local what blockers
  what=$(inhibitor_what "$ACTION")
  blockers=$(systemd-inhibit --list --mode=block 2>/dev/null |
             awk -v w="$what" '$0 ~ w {print}' | head -5)
  [ -n "$blockers" ] && say "note: block inhibitors on '$what' are present:" &&
    while IFS= read -r l; do say "      $l"; done <<<"$blockers"
  return 0
}

# Did the machine actually sleep since $1 (epoch seconds)?
suspended_since() {
  journalctl -k --since "@$1" -o cat 2>/dev/null | grep -q "PM: suspend entry"
}

# Wait for the machine to actually go under, and report how long it stayed
# there. We are frozen for the whole nap, so a `sleep 2` that took a lot longer
# than two seconds IS the nap: a measurement that survives the suspend, which a
# journal timestamp does not (journald is frozen too, so every kernel line from
# the sleep path is stamped with the moment of the *resume*).
#   echoes the seconds slept; returns 1 if it never went under in time.
watch_for_sleep() {
  local t0=$1 waited=0 a b gap
  # Test hook, like $AWAIT_CLAUDE_SHUT_SYSTEMCTL: claim the machine slept for N
  # seconds ("none" = it never went under), so the bounce/retry path can be
  # exercised without actually suspending anything.
  if [ -n "${AWAIT_CLAUDE_SHUT_FAKE_SLEEP:-}" ]; then
    [ "$AWAIT_CLAUDE_SHUT_FAKE_SLEEP" = none ] && return 1
    echo "$AWAIT_CLAUDE_SHUT_FAKE_SLEEP"; return 0
  fi
  while [ "$waited" -lt 25 ]; do
    a=$(date +%s); sleep 2; b=$(date +%s)
    gap=$(( b - a )); waited=$(( waited + 2 ))
    [ "$gap" -gt 3 ] && { echo "$(( gap - 2 ))"; return 0; }
    suspended_since "$t0" && { echo 0; return 0; }
  done
  return 1
}

# A snapshot of the kernel's wakeup-source counters, one
# "wakeupNN<TAB>name<TAB>count" per line. Diffing it across a suspend says who
# did the waking. Keyed on the sysfs node, not the name: several ACPI devices
# register two wakeup sources under the identical name (the power button and
# the lid each have a live one and a dead one), and keying on the name silently
# reads the dead twin's zero, which makes every source look like it just fired.
wakeup_snapshot() {
  local d n c
  for d in /sys/class/wakeup/*/; do
    n=$(cat "$d/name" 2>/dev/null) || continue
    c=$(cat "$d/active_count" 2>/dev/null) || continue
    printf '%s\t%s\t%s\n' "${d%/}" "$n" "$c"
  done
}

# Which sources fired since the snapshot in $1, as "name(+n) name(+n) ".
wakeup_since() {
  local before=$1 k n c c0
  [ -n "${AWAIT_CLAUDE_SHUT_FAKE_WOKE:-}" ] && { printf '%s ' "$AWAIT_CLAUDE_SHUT_FAKE_WOKE"; return 0; }
  while IFS=$'\t' read -r k n c; do
    [ -n "$k" ] || continue
    c0=$(printf '%s\n' "$before" | awk -F'\t' -v k="$k" '$1==k {print $3; exit}')
    [ "${c:-0}" -gt "${c0:-0}" ] && printf '%s(+%s) ' "$n" "$(( c - ${c0:-0} ))"
  done < <(wakeup_snapshot)
}

# Wakeup sources that mean a person did it on purpose: the power button, the
# lid, the built-in keyboard port, the Logitech receiver's devices. Everything
# else waking the machine four seconds after it fell asleep is the box (or the
# dock) talking to itself, and deserves another attempt.
HUMAN_WAKE_RE='(^PNP0C0C|^PNP0C0D|^serio|^hidpp|[Kk]eyboard|[Mm]ouse|[Tt]ouchpad)'

log_wake() {
  local slept=$1 woke=$2 irq name
  say "it slept for ${slept}s"
  [ -n "$woke" ] && say "woken by: $woke"
  irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)
  if [ -n "$irq" ]; then
    name=$(grep -E "^[[:space:]]*${irq}:" /proc/interrupts 2>/dev/null | awk '{print $(NF-1), $NF}')
    say "last wakeup IRQ: $irq ${name:+($name)}"
  fi
  return 0
}

# Coming out of suspend, the dock's monitors sometimes come back "connected"
# with an empty mode list: a black screen until the cable is replugged, and
# gnome-shell says "Failed to create KMS output: No modes available". Say so
# out loud, so a dark screen is not mistaken for a failed suspend.
check_outputs() {
  local s d n dead=
  for s in /sys/class/drm/card*-*/status; do
    d=${s%/status}; n=${d##*/}
    case "$n" in *DVI-I-*) continue;; esac   # evdi's virtual stubs, never real
    [ "$(cat "$s" 2>/dev/null)" = connected ] || continue
    [ -s "$d/modes" ] && continue
    dead="$dead $n"
  done
  [ -z "$dead" ] && return 0
  say "NOTE: these outputs came back with no modes (i.e. black):$dead"
  if [ -x /usr/local/sbin/reprobe-displays ]; then
    say "      the resume hook re-probes them; if they stay dark, press Super+F5."
  else
    say "      press Super+F5 (fix-screen), or replug the dock."
  fi
  notify "Screens came back blank" "No modes on:$dead - press Super+F5, or replug the dock."
  return 0
}

# Verify a suspend that logind has already accepted.
#   $1 t0 (epoch of the request)  $2 wakeup snapshot taken before it
#   $3 1 if the accepted request needed -i
# Returns 1 if the machine never went under (the caller then forces it).
# Otherwise it always exits: 0 if the machine really slept, non-zero if it kept
# bouncing straight back out. The retry is the whole point: the first attempt
# is the one that gets killed by a wakeup that was already in flight, and the
# second one almost always sticks.
verify_suspend() {
  local t0=$1 before=$2 forced=$3
  local tries=${AWAIT_CLAUDE_SHUT_TRIES:-3}
  local bounce=${AWAIT_CLAUDE_SHUT_BOUNCE:-20}
  local attempt=1 slept woke out rc

  while :; do
    say "request accepted; waiting for the machine to actually go to sleep..."
    slept=$(watch_for_sleep "$t0") || return 1

    woke=$(wakeup_since "$before")
    log_wake "$slept" "$woke"

    if [ "$slept" -ge "$bounce" ]; then
      say "confirmed: the system suspended, and has now resumed."
      check_outputs
      exit 0
    fi

    if [ -n "$woke" ] && printf '%s\n' ${woke} | grep -qE "$HUMAN_WAKE_RE"; then
      say "...and you woke it back up yourself, so that was your call, not a dud suspend."
      check_outputs
      exit 0
    fi

    if [ "$attempt" -ge "$tries" ]; then
      say "FAILED: the machine bounced straight back out of suspend $attempt times."
      say "        Something re-arms a wakeup the moment it goes under; the sources"
      say "        logged above are the place to start."
      notify "Suspend keeps bouncing" \
             "The machine woke itself $attempt times in a row. See $LOG"
      check_outputs
      exit 1
    fi

    attempt=$((attempt + 1))
    say "only ${slept}s of sleep: it woke itself straight back up. Attempt $attempt of $tries..."
    sleep 5                       # let whatever fired drain before trying again
    before=$(wakeup_snapshot)
    t0=$(date +%s)
    say ">>> systemctl $ACTION (attempt $attempt)"
    if [ "$forced" -eq 1 ]; then out=$(run_systemctl -i); else out=$(run_systemctl); fi
    rc=$?
    [ -n "$out" ] && say "systemctl said: $out"
    if [ "$rc" -ne 0 ]; then
      say "FAILED: attempt $attempt was refused (exit $rc). The machine is still awake."
      notify "Claude suspend failed" "Retry $attempt was refused. See $LOG"
      exit "$rc"
    fi
  done
}

# Run systemctl once. Echoes its output, returns its exit status.
# Overridable so the refusal/escalation path can be tested without suspending
# the machine (see the tests in the dotfiles repo).
SYSTEMCTL=${AWAIT_CLAUDE_SHUT_SYSTEMCTL:-systemctl}
run_systemctl() {
  $SYSTEMCTL "$ACTION" "$@" 2>&1
}

do_shutdown() {
  if [ "$DRYRUN" -eq 1 ]; then
    say "[dry-run] would run: systemctl $ACTION"
    exit 0
  fi

  # Past this point the decision is made: a SIGTERM here is systemd taking the
  # machine down, not a cancellation, and must not be logged as one.
  trap - INT TERM
  log_blockers

  local t0 out rc forced=0 wake_before
  wake_before=$(wakeup_snapshot)
  t0=$(date +%s)
  say ">>> systemctl $ACTION"
  out=$(run_systemctl); rc=$?
  [ -n "$out" ] && say "systemctl said: $out"

  # Refused because something holds a block inhibitor: that veto is exactly what
  # the user already decided against by arming this, so override it. `-i` needs
  # the polkit rule from the dotfiles repo (polkit/README.md); without it
  # systemctl fails fast with "Interactive authentication required" rather than
  # hanging, and we report that below.
  if [ "$rc" -ne 0 ]; then
    say "refused; retrying with -i (ignore inhibitors)…"
    t0=$(date +%s); forced=1
    out=$(run_systemctl -i); rc=$?
    [ -n "$out" ] && say "systemctl -i said: $out"
  fi

  if [ "$rc" -ne 0 ]; then
    say "FAILED: 'systemctl $ACTION' would not run. The machine is still awake."
    case "$out" in
      *authentication*|*Authentication*)
        say "       polkit blocked the override. Install the rule:"
        say "       ~/code/linux-setup/install.sh  (see polkit/README.md)";;
    esac
    notify "Claude $ACTION failed" "The machine is still awake. See ~/.local/state/await-claude-shut.log"
    exit "$rc"
  fi

  # systemctl returns as soon as logind accepts the request; the machine goes
  # down a moment later (delay inhibitors get a few seconds first). Accepted is
  # not the same as happened, so verify, and escalate once if nothing happened.
  local attempt
  for attempt in 1 2; do
    if [ "$ACTION" = suspend ]; then
      # Never returns unless the machine did not go under at all, in which case
      # we fall through and force it with -i below.
      verify_suspend "$t0" "$wake_before" "$forced"
    else
      # For poweroff/reboot/halt there is nothing to look for: if we are still
      # running half a minute later, it did not happen.
      say "request accepted; the machine should go down now…"
      sleep 30
    fi

    [ "$forced" -eq 1 ] && break
    say "nothing happened within the timeout. Something vetoed it; forcing with -i…"
    log_blockers
    wake_before=$(wakeup_snapshot)
    t0=$(date +%s); forced=1
    out=$(run_systemctl -i); rc=$?
    [ -n "$out" ] && say "systemctl -i said: $out"
    if [ "$rc" -ne 0 ]; then
      say "FAILED: the forced '$ACTION -i' exited $rc. The machine is still awake."
      notify "Claude $ACTION failed" "Even the forced attempt was refused. See ~/.local/state/await-claude-shut.log"
      exit "$rc"
    fi
  done

  say "WARNING: logind accepted the request (forced) and the machine is still up."
  say "         Check: systemd-inhibit --list ; journalctl -b -u systemd-logind"
  notify "Claude $ACTION did not happen" \
         "logind accepted it but the machine stayed up. See ~/.local/state/await-claude-shut.log"
  exit 1
}

# Wait for STABLE consecutive clear checks, then a re-checking grace countdown.
# The whole thing loops: if work restarts during the countdown, go back to waiting.
say "await-claude-shut: watching for Claude to finish (action: $ACTION, grace: ${GRACE}s, dry-run: $DRYRUN)"
say "each check takes a couple of seconds; log: $LOG"
while :; do
  clear=0
  while [ "$clear" -lt "$STABLE" ]; do
    if claude_busy; then
      [ "$clear" -gt 0 ] && say "Claude woke back up, restarting the count."
      clear=0
      say "Claude still active, checking again in ${INTERVAL}s…"
      nap "$INTERVAL"
    else
      clear=$((clear + 1))
      if [ "$clear" -lt "$STABLE" ]; then
        # Confirming checks are seconds apart, not minutes: the long interval
        # is for waiting out real work, not for double-checking a quiet machine.
        say "clear ($clear/$STABLE), confirming in ${CONFIRM}s…"
        nap "$CONFIRM"
      else
        say "clear ($clear/$STABLE)"
      fi
    fi
  done

  # Grace countdown against a wall-clock deadline, so the periodic re-checks
  # cost real time instead of silently stretching the countdown.
  say "Claude is done. ${ACTION} in ${GRACE}s. Press Ctrl+C (or close this window) to cancel."
  deadline=$(( $(date +%s) + GRACE ))
  last_check=$(date +%s)
  restarted=0
  while :; do
    now=$(date +%s)
    left=$(( deadline - now ))
    [ "$left" -le 0 ] && break
    printf '\r  %s in %3ds …  (Ctrl+C to cancel)   ' "$ACTION" "$left"
    if [ $(( now - last_check )) -ge 10 ]; then
      if claude_busy; then restarted=1; break; fi
      last_check=$(date +%s)
    fi
    nap 1
  done
  wipe

  if [ "$restarted" -eq 1 ]; then
    say "Claude started working again, resuming the wait."
    continue
  fi
  do_shutdown
done
