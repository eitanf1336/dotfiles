#!/usr/bin/env bash
# claude-c-deed - the claude-c board for the DEED job, on the deed account.
#
# Same board, same keys, same chats.py as `claude-c`. Two differences:
#   1. it boots straight into the "Deed" project, so the list is only deed work;
#   2. it runs against ~/.claude-deed, which holds its own Claude login, so
#      every chat it opens bills the deed account instead of Eitan's main one.
# The account swap is what this exists for: launching those chats from plain
# `claude-c` would silently spend the main quota, which is the whole thing the
# separate account was set up to avoid.
#
# Switch which account the deed config is signed into with `claude-account-deed`.
set -euo pipefail

CFG="$HOME/.claude-deed"
export CLAUDE_CONFIG_DIR="$CFG"

# Preflight the login. A file existing proves nothing; asking Claude proves the
# token still works. Doing it HERE, before the board spawns anything, is also
# the moment a stale token gets refreshed: leave it to the board and the deed
# daemon and the first chat both try to refresh the same expired token at once,
# one of them loses the race, and you get a "run /login" banner for the ~60s it
# takes the daemon to notice the other one succeeded.
# Read it into a variable rather than piping: `claude auth status | grep -q`
# leaves claude writing into a pipe grep already closed, and it then sits there
# until the timeout kills it, adding 15 dead seconds to every launch.
# --foreground matters: plain `timeout` runs the command in its own process
# group, and claude then touches the terminal from a background group, takes
# SIGTTOU and stops dead until the timeout fires. That is 15 silent seconds
# before the board ever draws.
auth=$(timeout --foreground 15 claude auth status 2>/dev/null || true)
case "$auth" in
  *'"loggedIn": true'*) ;;
  *) echo "Not signed in to the deed account ($CFG): run /login once a chat opens." >&2 ;;
esac

# The board rewrites projects.json from memory every time the P panel is used,
# so a board that was already open when the Deed project was added can drop it.
# Cheap to put back, and it makes this launcher work on a fresh machine too.
python3 - <<'PY'
import json, os, pathlib
d = pathlib.Path(os.path.expanduser("~/.claude/chats"))
d.mkdir(parents=True, exist_ok=True)


def merge(name, updates):
    p = d / name
    try:
        cur = json.loads(p.read_text())
    except Exception:
        cur = {}
    before = json.dumps(cur, sort_keys=True)
    for key, val in updates.items():
        if isinstance(val, dict):
            cur.setdefault(key, {}).update(val)
        else:
            cur.setdefault(key, val)
    if json.dumps(cur, sort_keys=True) != before:
        p.write_text(json.dumps(cur, indent=2) + "\n")


merge("project_config_dirs.json", {"Deed": "~/.claude-deed"})
merge("projects.json", {
    "list": {"Deed": "Deed"},
    "cwds": {"Deed": os.path.expanduser("~/code/MyLittleProjects/DeedPortal")},
})
PY

# Pass everything through, but default the project to Deed when no project was
# named, so `claude-c-deed` and `claude-c-deed -n` both land in the deed list.
has_project=0
for a in "$@"; do
  case "$a" in -*) ;; *) has_project=1 ;; esac
done
if [ "$has_project" -eq 1 ]; then
  exec claude-c "$@"
fi
exec claude-c Deed "$@"
