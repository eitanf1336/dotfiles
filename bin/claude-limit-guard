#!/usr/bin/env python3
"""claude-limit-guard - poll the weekly usage limit every minute and slam the
brakes when it gets close to the floor.

Exists because a long-running agent only notices a limit between batches, and a
single Fable batch can eat several points on its own. This runs outside every
agent, so the check really is every minute.

On crossing the stop threshold it:
  1. writes ~/.claude/limits-guard/PAUSE  (agents are told to honour this file)
  2. WhatsApps the "My Claude" group
It clears the flag again once usage falls back under the threshold (weekly reset).
"""
import json, os, shutil, subprocess, sys, urllib.parse, urllib.request
from datetime import datetime

STOP_AT   = float(os.environ.get("CLG_STOP_AT", "95"))
WARN_AT   = float(os.environ.get("CLG_WARN_AT", "90"))
BLIND_AT  = int(os.environ.get("CLG_BLIND_AT", "4"))   # consecutive failed reads before shouting
RATE_PTS      = float(os.environ.get("CLG_RATE_PTS", "8"))      # weekly points ...
RATE_WINDOW_H = float(os.environ.get("CLG_RATE_WINDOW_H", "3")) # ... within this many hours = burn alarm
DIR       = os.path.expanduser("~/.claude/limits-guard")
PAUSE     = os.path.join(DIR, "PAUSE")
STATE     = os.path.join(DIR, "state.json")
LOG       = os.path.join(DIR, "guard.log")
GROUP_JID = "120363410856554324@g.us"
BRIDGE    = os.environ.get("CWB_BRIDGE_SEND", "http://localhost:8080/api/send")


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{datetime.now().isoformat(timespec='seconds')} {msg}\n")


def wa(text):
    try:
        payload = json.dumps({"recipient": GROUP_JID, "message": text, "store_local": True}).encode()
        req = urllib.request.Request(BRIDGE, data=payload,
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as r:
            log(f"whatsapp -> {r.status}")
    except Exception as e:
        log(f"whatsapp FAILED: {e}")


def main():
    os.makedirs(DIR, exist_ok=True)
    try:
        state0 = json.load(open(STATE))
    except Exception:
        state0 = {}

    cli = shutil.which("claude-limits") or os.path.expanduser("~/.local/bin/claude-limits")
    try:
        r = subprocess.run([cli, "--json"], capture_output=True,
                           text=True, timeout=30, check=True)
        data = json.loads(r.stdout)
    except Exception as e:
        # The usage endpoint rate-limits hard (HTTP 429). A guard that fails
        # silently is worse than no guard, so count the failures and shout.
        fails = int(state0.get("fails", 0)) + 1
        state0["fails"] = fails
        json.dump(state0, open(STATE, "w"))
        log(f"read FAILED (#{fails}): {e}")
        if fails == BLIND_AT:
            wa("\U0001F916\U0001F916\U0001F916\n\nLimit guard is BLIND: the usage "
               f"endpoint has refused {fails} reads in a row (rate limit or auth). "
               "I cannot see your weekly %, so the automatic pause at 95% is NOT "
               "protecting you right now.\n\n\U0001F916\U0001F916\U0001F916")
        return 0                      # never let a blip trigger a false pause

    if state0.get("fails"):
        log(f"read recovered after {state0['fails']} failures")

    week = (data.get("seven_day") or {}).get("utilization")
    if week is None:
        log("no seven_day utilization in payload")
        return 0
    week = float(week)

    try:
        state = json.load(open(STATE))
    except Exception:
        state = {}
    last = state.get("last")
    warned = bool(state.get("warned"))
    paused = os.path.exists(PAUSE)

    if week >= STOP_AT and not paused:
        with open(PAUSE, "w") as f:
            f.write(f"weekly={week}% at {datetime.now().isoformat(timespec='seconds')}\n")
        wa(f"\U0001F916\U0001F916\U0001F916\n\nWeekly limit guard tripped: {week:.0f}% used, "
           f"only {100 - week:.0f}% left.\n\nPAUSE flag is set, agents should be "
           f"parking now. Nothing is lost, it can resume after the weekly reset.\n\n"
           f"\U0001F916\U0001F916\U0001F916")
        log(f"PAUSE set at {week}%")
    elif week < STOP_AT and paused:
        os.remove(PAUSE)
        warned = False
        wa(f"\U0001F916\U0001F916\U0001F916\n\nWeekly usage back down to {week:.0f}%. "
           f"PAUSE flag cleared, agents may resume.\n\n\U0001F916\U0001F916\U0001F916")
        log(f"PAUSE cleared at {week}%")
    elif week >= WARN_AT and not warned and not paused:
        warned = True
        wa(f"\U0001F916\U0001F916\U0001F916\n\nHeads up: weekly usage at {week:.0f}%. "
           f"Agents pause automatically at {STOP_AT:.0f}%.\n\n\U0001F916\U0001F916\U0001F916")
        log(f"warned at {week}%")

    # Burn-rate alarm (4 Nov 2026): on 1 Nov the weekly bar went 75% -> 94% in
    # six hours while the 90/95 thresholds were still far off. A fast climb is
    # the signal, whatever the level, so shout early with who is spending.
    now = datetime.now().timestamp()
    hist = [h for h in state.get("hist", []) if now - h[0] <= RATE_WINDOW_H * 3600]
    hist.append([now, week])
    rate_alerted = float(state.get("rate_alerted", 0))
    rise = week - min(h[1] for h in hist)
    if rise >= RATE_PTS and now - rate_alerted > RATE_WINDOW_H * 3600:
        rate_alerted = now
        try:
            top = subprocess.run(["quota-budget", "top"], capture_output=True, text=True,
                                 timeout=60).stdout.strip().splitlines()[:3]
        except Exception:
            top = []
        who = "\n".join("- " + " ".join(t.split()[:1] + t.split()[4:5]).replace("/home/eitan/", "~/")
                        for t in top) or "- (quota-budget top failed)"
        wa(f"\U0001F916\U0001F916\U0001F916\n\nQuota BURN alarm: weekly usage rose {rise:.0f} points "
           f"in the last {RATE_WINDOW_H:g}h (now {week:.0f}%). Biggest spenders this week:\n{who}\n\n"
           f"Check `quota-budget top` and stop whatever is running unattended.\n\n"
           f"\U0001F916\U0001F916\U0001F916")
        log(f"BURN alarm: +{rise}% in {RATE_WINDOW_H}h, now {week}%")

    if week != last:
        log(f"weekly={week}%")
    json.dump({"last": week, "warned": warned, "fails": 0, "hist": hist,
               "rate_alerted": rate_alerted}, open(STATE, "w"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
