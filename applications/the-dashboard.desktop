[Desktop Entry]
Type=Application
Version=1.0
Name=The Dashboard
GenericName=Project analytics
Comment=Every project, every shekel, every user, in one place
Exec=/home/eitan/bin/dashboard
Icon=/home/eitan/code/MyProjects/TheDashboard/web/icons/icon-512.png
Terminal=false
Categories=Office;Finance;Development;
Actions=Money;Marketing;Users;Effort;
Keywords=dashboard;analytics;revenue;expenses;users;projects;
StartupNotify=true
# Chrome --app windows are identified by the app_id Chrome derives from the URL,
# never by --class. Same form that already works for the Guitar and Learning apps.
StartupWMClass=chrome-localhost_7777__-Default

[Desktop Action Money]
Name=Money
Exec=/home/eitan/bin/dashboard money

[Desktop Action Marketing]
Name=Marketing queue
Exec=/home/eitan/bin/dashboard marketing

[Desktop Action Users]
Name=Users
Exec=/home/eitan/bin/dashboard users

[Desktop Action Effort]
Name=Build effort
Exec=/home/eitan/bin/dashboard effort
