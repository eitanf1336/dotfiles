[Unit]
Description=Push the laptop-only numbers (Claude effort, Cloudflare token, Ko-fi/credential files) to The Dashboard on the server
After=network-online.target server-link.service

[Service]
Type=oneshot
ExecStart=%h/code/linux-setup/bin/dashboard-laptop-push all
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
