[Unit]
Description=Keep a usable copy of the deed Claude login and restore it if Claude blanks it

[Service]
Type=oneshot
ExecStart=%h/bin/deed-creds-guard
# File comparison and a copy: no network, nothing to rate-limit.
Nice=10
# Exit 1 just means "a browser login is needed", not a failure worth alerting on.
SuccessExitStatus=0 1
