#!/bin/bash
# vpn-prune-tabs [all]: close the dead sign-in tabs in the vpn-jump Chrome (debugging port 9333), always keeping
# one page so the window stays. Without "all" it acts only when more than 3 pages are open. Prints how many closed.
# Why (15 to 16 Nov 2026): every robot login left its Microsoft tabs open (317 tabs, 13 GB), AND vpn-mslogin reads
# "the first Microsoft tab" through cdp.js, so with stale ones open it read the wrong tab ("password not filled").
# vpn-relogin calls it with "all" right before it opens a fresh sign-in page; vpn-watch calls it while srv3 is up.
timeout 30 python3 - "${1:-}" <<'PY' 2>/dev/null || echo 0
import json, sys, urllib.request
B = "http://127.0.0.1:9333"
pages = [t for t in json.load(urllib.request.urlopen(B + "/json/list", timeout=5)) if t.get("type") == "page"]
dead = [t for t in pages if t.get("url", "").startswith(("https://login.microsoftonline.com/", "https://login.live.com/",
        "https://technion.eu.sase.checkpoint.com/", "about:blank", "chrome://newtab"))]
if sys.argv[1] == "all":   # leave exactly one fresh blank page: a kept Microsoft tab would be the one cdp.js reads
    try:
        keep = json.load(urllib.request.urlopen(urllib.request.Request(B + "/json/new?about:blank", method="PUT"), timeout=5))["id"]
        dead = [t for t in dead if t["id"] != keep]
    except Exception:
        dead.sort(key=lambda t: not t.get("url", "").startswith("about:blank"))
        if len(dead) == len(pages):
            dead = dead[1:]
elif len(dead) == len(pages):
    dead = dead[1:]
closed = 0
if sys.argv[1] == "all" or len(pages) > 3:
    for t in dead:
        for method in ("GET", "PUT"):
            try:
                urllib.request.urlopen(urllib.request.Request(B + "/json/close/" + t["id"], method=method), timeout=5).read()
                closed += 1
                break
            except Exception:
                pass
print(closed)
PY
