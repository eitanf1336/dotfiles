#!/usr/bin/env python3
"""vpn-totp: print the current 6-digit code of the Technion Microsoft "authenticator app" method.
The secret lives ONLY in ~/.config/vpn-jump/totp.cred, encrypted by systemd-creds with this machine's
key (a copy of the file is useless elsewhere), or, if that was not possible, in ~/.config/vpn-jump/totp.secret
(mode 600). Never prints or logs the secret. Used by vpn-relogin when Microsoft asks for a code."""
import base64, hmac, hashlib, os, struct, subprocess, sys, time
home = os.path.expanduser("~/.config/vpn-jump")
cred, plain = os.path.join(home, "totp.cred"), os.path.join(home, "totp.secret")
if os.path.exists(cred):
    secret = subprocess.run(["systemd-creds", "decrypt", "--user", "--name=vpn-totp", cred, "-"],
                            capture_output=True, check=True).stdout.decode().strip()
elif os.path.exists(plain):
    secret = open(plain).read().strip()
else:
    sys.exit("no TOTP secret stored (vpn-totp-store)")
s = secret.replace(" ", "").upper()
key = base64.b32decode(s + "=" * (-len(s) % 8))
counter = int(time.time()) // 30 + (int(sys.argv[1]) if len(sys.argv) > 1 else 0)
h = hmac.new(key, struct.pack(">Q", counter), hashlib.sha1).digest()
o = h[-1] & 15
print("%06d" % ((struct.unpack(">I", h[o:o + 4])[0] & 0x7FFFFFFF) % 1000000))
