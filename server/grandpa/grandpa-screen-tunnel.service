[Unit]
Description=ServerScreen tunnel: little's screen page at grandpa 127.0.0.1:7800
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eitan
# little's key entry: restrict,port-forwarding,permitopen="127.0.0.1:7800" (little stays bound to localhost)
ExecStart=/usr/bin/ssh -N -i /home/eitan/.ssh/id_ed25519_screen -o BatchMode=yes \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new -L 127.0.0.1:7800:127.0.0.1:7800 eitan@192.168.68.54
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
