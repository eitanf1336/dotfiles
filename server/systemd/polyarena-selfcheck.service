[Unit]
Description=PolyArena daily self-check: coverage, feed, accounting, sim exchange, live wallet (read only), bots, wakes, services, tests; posts a verdict to the PolyArena group
After=polyarena.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# once a day: started after the wakes, and by the 12:00 fallback timer only if that did not happen
ExecCondition=/bin/bash -c '! test -e %h/code/MyProjects/PolyArena/data/selfcheck/$(date +%%Y-%%m-%%d).md'
WorkingDirectory=%h/code/MyProjects/PolyArena
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'exec /usr/bin/python3 %h/code/MyProjects/PolyArena/bin/arena-selfcheck >> %h/code/MyProjects/PolyArena/data/logs/selfcheck.log 2>&1'
TimeoutStartSec=3600
Nice=10
