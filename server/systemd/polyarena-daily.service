[Unit]
Description=PolyArena daily wake of every bot (live first), survives the Claude limit, numbered inbox to WhatsApp
After=polyarena.service

[Service]
Type=simple
WorkingDirectory=%h/code/MyProjects/PolyArena
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'exec %h/code/MyProjects/PolyArena/bin/arena-daily >> %h/code/MyProjects/PolyArena/data/logs/daily-$(date +%%Y%%m%%d).log 2>&1'
CPUWeight=1000
