[Unit]
Description=The Dashboard (analytics for every project), on the server; the laptop reaches it through server-link
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/MyProjects/TheDashboard
ExecStart=/usr/bin/python3 -m dashboard.server
Restart=on-failure
RestartSec=3
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=DASHBOARD_CHROME=%h/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome
Environment=DASHBOARD_PLAYWRIGHT_NODE_PATH=%h/.local/share/playwright-runtime/node_modules
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=7777

[Install]
WantedBy=default.target
