[Unit]
Description=PolyArena stage 3 wake triggers: wake a stage 3+ fable when one of its own WAKE_IF.json rules holds (bin/arena-watch)
After=polyarena.service

[Service]
Type=oneshot
WorkingDirectory=%h/code/MyProjects/PolyArena
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/code/MyProjects/PolyArena/bin/arena-watch
TimeoutStartSec=300
